load("//admin/typescript:typescript.bzl", "ts_project")
load("@aspect_rules_esbuild//esbuild:defs.bzl", "esbuild")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@npm//:prettier/package_json.bzl", prettier_bin = "bin")

ts_project(
    name = "script_lib",
    deps = [
        "//client/web/blobs/helpers",
        "//client/web/helpers",
        "//shared/design",
    ],
)

esbuild(
    name = "script_bundle_file",
    srcs = [
        ":script_lib",
        "//:package_light_json_file",
    ],
    config = "internal/blobs_script_esbuild_config.cjs",
    entry_point = "internal/blobs_script.js",
    minify = True,
    output = "blobs_script_bundle.js",
)

genrule(
    name = "blobs_script_string",
    srcs = ["blobs_script_bundle.js"],
    outs = ["blobs_script_string.js"],

    # Notes:
    #  - Within script, we call the drawBlob function to initialize it (so esbuild doesn't remove it)
    #  - We find the last instance of a function call and assume that's the end of our library calls
    #  - We set the drawBlob function to the last function call (which is our init function)
    #  - We filter out sourceMappingURL so the browser doesn't request a non-existent map file
    cmd = """
        $(location //:node) --eval "let bundle = fs.readFileSync('$<').toString(); bundle = bundle.split('\\n').filter(line => !line.startsWith('//# sourceMappingURL=')).join('\\n'); console.log('export const blobScriptString = ' + JSON.stringify(bundle));" > $@
    """,
    tools = [
        "//:node",
    ],
)

js_library(
    name = "script",
    srcs = [
        "blobs_script_string.d.ts",
        ":blobs_script_string",
    ],
    visibility = [
        "//app:__subpackages__",
        "//client/web:__subpackages__",
    ],
    deps = [
        "//shared/error",
        "//shared/helpers",
    ],
)

# Write a debug bundle file to our repository. This is useful for reviewing changes
# to the file, and flagging if any mistakenly occur. We write the non-minified file
# and it is compared to a committed copy to ensure that we don't accidentally modify the file.
# Committing the minified file would result in false changes if minified variables change.

esbuild(
    name = "script_bundle_debug_file",
    srcs = [
        ":script_lib",
        "//:package_light_json_file",
    ],
    config = "internal/blobs_script_esbuild_config.cjs",
    entry_point = "internal/blobs_script.js",
    minify = False,
    output = "blobs_script_bundle_debug_unminified.js",
)

prettier_bin.prettier_binary(
    name = "prettier",
)

genrule(
    name = "blobs_script_bundle_debug_file",
    srcs = [
        "blobs_script_bundle_debug_unminified.js",
        "//:prettier_config_files",
    ],
    outs = ["blobs_script_bundle_debug.js"],
    cmd = """
echo "// @generated by //client/web/blobs/script:write_blobs_script_bundle_debug" >> $@
echo "/* eslint-disable */" >> $@
echo >> $@
BAZEL_BINDIR=$(BINDIR) $(location :prettier) "$$(readlink -f "$(BINDIR)/{}/blobs_script_bundle_debug_unminified.js")" >> $@
""".format(package_name()),
    tools = [":prettier"],
)

write_source_files(
    name = "write_blobs_script_bundle_debug",
    files = {
        "internal/blobs_script_bundle_debug.js": "blobs_script_bundle_debug.js",
    },
)

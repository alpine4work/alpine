genrule(
    name = "all_rpc_implementations_file",
    srcs = [],
    outs = ["rpc/all_rpc_implementations.js"],
    cmd = "printf \"// @generated by //server:all_rpc_implementations_file\n\nimport \\\"~/shared/rpc/all_rpc_definitions\\\";\n\n{}\" > \"$@\"".format("".join(["import \\\"~/server/{}\\\";\n".format(file) for file in glob(
        [
            "rpc/**/*.ts",
            "rpc/**/*.tsx",
        ],
        exclude = [
            "**/*.test.ts",
            "**/*.test.tsx",
            "**/*.d.ts",
            "**/*.d.tsx",
            "rpc/internal/**/*.ts",
            "rpc/internal/**/*.tsx",
            # This file imports `all_rpc_implementations.ts` so prevent cyclic import.
            "rpc/get_rpc_implementation.ts",
        ],
    )])),
)

js_library(
    name = "all_rpc_implementations",
    srcs = [
        "rpc/all_rpc_implementations.d.ts",
        ":all_rpc_implementations_file",
    ],
)

genrule(
    name = "all_dynamo_tables_file",
    srcs = [],
    outs = ["dynamo/all_dynamo_tables.js"],
    cmd = "printf \"// @generated by //server:all_dynamo_tables_file\n\nimport {{checkModuleDoesNotExportDynamoTableSchema}} from \\\"~/server/dynamo/internal/check_module_does_not_export_dynamo_table_schema\\\";\n\n{}\" > \"$@\"".format("".join(["import * as module{i} from \\\"~/server/{file}\\\";\ncheckModuleDoesNotExportDynamoTableSchema(\\\"~/server/{file}\\\", module{i});\n\n".format(
        file = file,
        i = i + 1,
    ) for i, file in enumerate(glob(
        [
            "dynamo/**/*.ts",
            "dynamo/**/*.tsx",
        ],
        exclude = [
            "**/*.test.ts",
            "**/*.test.tsx",
            "**/*.d.ts",
            "**/*.d.tsx",
            # This file imports `all_dynamo_tables.ts` so prevent cyclic import.
            "dynamo/get_all_dynamo_table_schemas.ts",
            # This file is already imported by `all_dynamo_tables.ts` so prevent double import.
            "dynamo/internal/check_module_does_not_export_dynamo_table_schema.ts",
        ],
    ))])),
)

js_library(
    name = "all_dynamo_tables",
    srcs = [
        "dynamo/all_dynamo_tables.d.ts",
        ":all_dynamo_tables_file",
    ],
)

load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//admin/typescript:typescript.bzl", "ts_project")

ts_project(
    name = "dynamo",
    test_deps = [
        "//:node_modules/expect-type",
        "//server/dynamo/test_helpers/jest",
        "//server/dynamo/test_helpers/shared",
    ],
    visibility = [
        "//admin:__subpackages__",
        "//app:__subpackages__",
        "//server:__subpackages__",
    ],
    deps = [
        ":all_dynamo_tables",
        "//:node_modules/@aws-sdk/client-dynamodb",
        "//:node_modules/@types/json-stable-stringify",
        "//:node_modules/aws4fetch",
        "//:node_modules/date-fns",
        "//:node_modules/json-stable-stringify",
        "//:node_modules/murmurhash",
        "//:node_modules/prosemirror-model",
        "//:node_modules/prosemirror-transform",
        "//server/emails",
        "//server/helpers",
        "//server/schema",
        "//shared/content",
        "//shared/context",
        "//shared/documents",
        "//shared/error",
        "//shared/helpers",
        "//shared/id",
        "//shared/messaging",
        "//shared/models",
        "//shared/schema",
        "//shared/tracer",
    ],
)

genrule(
    name = "all_dynamo_tables_file",
    srcs = [],
    outs = ["all_dynamo_tables.js"],
    cmd = "printf \"// @generated by //server/dynamo:all_dynamo_tables_file\n\nconst {{finishInitializingAllDynamoTableSchemas}} = require(\\\"./internal/dynamo_table_schema\\\");\nconst {{checkModuleDoesNotExportDynamoTableSchema}} = require(\\\"./internal/check_module_does_not_export_dynamo_table_schema\\\");\n\n{}finishInitializingAllDynamoTableSchemas();\n\" > \"$@\"".format("".join(["const module{i} = require(\\\"./{file}\\\");\ncheckModuleDoesNotExportDynamoTableSchema(\\\"~/server/dynamo/{file}\\\", module{i});\n\n".format(
        file = file[:file.rindex(".")],
        i = i + 1,
    ) for i, file in enumerate(glob(
        [
            "**/*.ts",
            "**/*.tsx",
        ],
        exclude = [
            "**/*.test.ts",
            "**/*.test.tsx",
            "**/*.d.ts",
            "**/*.d.tsx",
            # This file imports `all_dynamo_tables.ts` so prevent cyclic import.
            "get_all_dynamo_table_schemas.ts",
            # This file is already imported by `all_dynamo_tables.ts` so prevent double import.
            "internal/check_module_does_not_export_dynamo_table_schema.ts",
        ],
    ))])),
)

js_library(
    name = "all_dynamo_tables",
    srcs = [":all_dynamo_tables_file"],
)

write_source_files(
    name = "write_schema",
    files = {
        "internal/dynamo_generated_schema_description.ts": "//admin/dynamo:dynamo_schema_description",
    },
)

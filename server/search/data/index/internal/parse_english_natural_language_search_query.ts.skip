import nlp from "compromise";
import levenshtein from "damerau-levenshtein";
import {stemmer} from "stemmer";
import {assert} from "~/shared/helpers/control/assert.js";
import {exhaustive} from "~/shared/helpers/control/exhaustive.js";
import {getOrSetDefaultMapValue} from "~/shared/helpers/map/get_or_set_default_map_value.js";
import {AccountId} from "~/shared/id/types/id_types.js";
import {SearchEntityIdObject} from "~/shared/search/search_entity_id.js";

// NOCOMMIT:
//
// Features:
// - People
// - Time
//
// Examples:
// - my documents
// - emily's documents
// - emily documents
// - emilys documents
// - message from emily about trains
// - train message from emily
// - documents i wrote
// - documents i authored
// - documents written by me
// - train document by emily
// - train document created recently
// - train document created yesterday
// - train document created last month
// - train document updated recently
// - new posts
// - new train post in transit channel
// - posts in transit channel
// - train posts in transit channel
// - caleb's train documents
// - caleb meredith's documents
// - shruti narkar's documents
// - caleb meredith's train documents
// - my train documents
// - my blue train documents
// - my documents about trains
// - my the cat in the hat documents
// - trains from caleb's documents
//
// Created by X:
// - #Noun documents
// - documents created by #Noun
//
// Updated by X:
// - documents updated by #Noun
// - documents modified by #Noun
// - documents written by #Noun
// - documents authored by #Noun
// - documents from #Noun

/**
 * Support name searches that are either just first name, first/last name, or
 * first/middle/last name. For example: "caleb", "caleb meredith", or "caleb
 * wesley meredith".
 *
 * We will compare these words to account names in our space to see if there's
 * a real name match.
 */
const possibleNamePattern = "#Noun{0,2} #Noun";

/**
 * Same as `possibleNamePattern` but require the name to be in possessive form.
 * Useful for more ambiguous phrases we want to disambiguate.
 *
 * Either requires the word to be tagged with `#Possessive` or `#Plural`. We
 * include `#Plural` In case the user was lazy and typed "calebs" instead of
 * "caleb's".
 */
const possiblePossessiveNamePattern = "#Noun{0,2} (#Noun&&#Possessive)";

type View = ReturnType<(typeof nlp)["tokenize"]>;
type Term = View["docs"][number][number];

/**
 * Helper for fuzzy match individual terms. Lower cases and stems text before
 * comparing edit distance.
 */
class MatchTerm {
    public static readonly my = new this("my");
    public static readonly documents = new this("documents");
    public static readonly docs = new this("docs");
    public static readonly messages = new this("messages");
    public static readonly comments = new this("comments");
    public static readonly channels = new this("channels");
    public static readonly posts = new this("posts");
    public static readonly chats = new this("chats");
    public static readonly tasks = new this("tasks");
    public static readonly collections = new this("collections");

    private static readonly _termCache = new WeakMap<Term, string>();
    private readonly _text: string;

    constructor(text: string) {
        this._text = stemmer(text.toLowerCase());
    }

    public isFuzzyMatch(term: Term): boolean {
        const termText = getOrSetDefaultMapValue(MatchTerm._termCache, term, () =>
            stemmer(term.text.toLowerCase()),
        );

        // Same logic as OpenSearch with `fuzziness: "AUTO"`.
        // https://www.elastic.co/guide/en/elasticsearch/reference/current/common-options.html#fuzziness

        if (this._text.length <= 2) {
            return this._text === termText;
        }

        if (this._text.length <= 5) {
            const {steps} = levenshtein(this._text, termText, 2);
            return steps <= 1;
        }

        const {steps} = levenshtein(this._text, termText, 3);
        return steps <= 2;
    }
}

class Lexer {
    public readonly terms: ReadonlyArray<Term>;
    public readonly term: Term | null;
    public readonly termIndex = 0;

    constructor(terms: ReadonlyArray<Term>) {
        this.terms = terms;
        this.term = this.termIndex < this.terms.length ? this.terms[this.termIndex]! : null;
    }

    /**
     * Advance the lexer to the next term.
     */
    public advanceTerm(): Term {
        assert(this.termIndex < this.terms.length);
        const lastTerm = this.term!;

        // @ts-expect-error: We're allowed to mutate `termIndex` inside of this class.
        // Just not outside of it.
        this.termIndex++;

        const nextTerm = this.termIndex < this.terms.length ? this.terms[this.termIndex]! : null;

        // @ts-expect-error: We're allowed to mutate `term` inside of this class. Just
        // not outside of it.
        this.term = nextTerm;

        return lastTerm;
    }
}

/**
 * Is the term casually possessive? Either the word needs to be tagged with
 * `#Possessive` or the word needs to end with an "s". In case the user was
 * lazy and typed "calebs" instead of "caleb's".
 */
function isCasuallyPossessiveTerm(term: Term): boolean {
    return term.tags?.has("Possessive") || term.text.endsWith("s");
}

type T = {
    readonly primaryQueryText: string;
    readonly controlQueryText: string | null;
};

type SearchQueryBoost = SearchQueryAccountBoost;

type SearchQueryAccountBoost = {
    readonly accountId: AccountId;
    readonly entityTypes: ReadonlyArray<SearchEntityIdObject["type"]>;
    readonly level: "Creator" | "MajorContributor" | "AnyContributor";
};

function parse(
    lexer: Lexer,
    {
        actorAccountId,
    }: {
        actorAccountId: AccountId;
    },
) {
    const boosts: Array<SearchQueryBoost> = [];
    const controlTerms = new Set<Term>();

    let state:
        | {type: "ConsecutiveNouns"; terms: Array<Term>}
        | {
              type: "PossessiveContext";
              state:
                  | {type: "Personal"; term: Term}
                  | {type: "ConsecutiveNouns"; terms: Array<Term>};
          }
        | {type: "None"} = {type: "None"};

    while (lexer.term) {
        {
            const startTermIndex = lexer.termIndex;
            const entityTypes = tryParseSearchEntityTypes(lexer);
            if (entityTypes) {
                const endTermIndex = lexer.termIndex;

                switch (state.type) {
                    // NOCOMMIT: Name filtering!
                    case "ConsecutiveNouns": {
                        break;
                    }
                    case "PossessiveContext": {
                        break;
                    }
                    case "None": {
                        break;
                    }
                    default:
                        throw exhaustive(state);
                }

                boosts.push({
                    // Treat search entity type without any other specifier as a boost for stuff
                    // we've contributed to.
                    accountId: actorAccountId,
                    entityTypes,
                    level: "MajorContributor",
                });

                for (const controlTerm of lexer.terms.slice(startTermIndex, endTermIndex)) {
                    controlTerms.add(controlTerm);
                }
            }
        }

        // If we enter a possessive context then we try to keep reading terms until we
        // see the type of entity we're possessing. This supports queries like "my
        // train documents" or "caleb's train documents" where the word "train"
        // shouldn't put us into a `ConsecutiveNouns` state.
        if (state.type === "PossessiveContext") {
            lexer.advanceTerm();
            continue;
        }

        if (MatchTerm.my.isFuzzyMatch(lexer.term)) {
            const term = lexer.advanceTerm();

            state = {type: "PossessiveContext", state: {type: "Personal", term}};
            continue;
        }

        if (lexer.term.tags?.has("Noun")) {
            const term = lexer.advanceTerm();

            if (state.type !== "ConsecutiveNouns") {
                state = {type: "ConsecutiveNouns", terms: [term]};
            } else {
                state.terms.push(term);
            }

            if (term.tags?.has("Possessive") || term.text.endsWith("s")) {
                state = {type: "PossessiveContext", state};
            }
            continue;
        }

        lexer.advanceTerm();
        state = {type: "None"};
    }

    // if (lexer.term.tags?.has("Noun")) {
    //     const term1 = lexer.advanceTerm();

    //     // NOCOMMIT
    //     if (isCasuallyPossessiveTerm(term1)) {
    //     }
    // }
}

/**
 * Try to parse an entity type from the lexer.
 */
function tryParseSearchEntityTypes(lexer: Lexer): Array<SearchEntityIdObject["type"]> | null {
    if (!lexer.term) return null;

    if (MatchTerm.documents.isFuzzyMatch(lexer.term) || MatchTerm.docs.isFuzzyMatch(lexer.term)) {
        lexer.advanceTerm();

        if (
            MatchTerm.messages.isFuzzyMatch(lexer.term) ||
            MatchTerm.comments.isFuzzyMatch(lexer.term)
        ) {
            lexer.advanceTerm();
            return ["DocumentComment"];
        }

        return ["Document"];
    }

    if (MatchTerm.channels.isFuzzyMatch(lexer.term)) {
        lexer.advanceTerm();
        return ["Channel"];
    }

    if (MatchTerm.posts.isFuzzyMatch(lexer.term)) {
        lexer.advanceTerm();

        if (
            MatchTerm.messages.isFuzzyMatch(lexer.term) ||
            MatchTerm.comments.isFuzzyMatch(lexer.term)
        ) {
            lexer.advanceTerm();
            return ["PostComment"];
        }

        return ["Post"];
    }

    if (MatchTerm.chats.isFuzzyMatch(lexer.term)) {
        lexer.advanceTerm();

        if (
            MatchTerm.messages.isFuzzyMatch(lexer.term) ||
            MatchTerm.comments.isFuzzyMatch(lexer.term)
        ) {
            lexer.advanceTerm();
            return ["ChatMessage"];
        }

        return ["Chat"];
    }

    if (MatchTerm.tasks.isFuzzyMatch(lexer.term)) {
        lexer.advanceTerm();

        if (MatchTerm.collections.isFuzzyMatch(lexer.term)) {
            lexer.advanceTerm();
            return ["TaskCollection"];
        }

        return ["Task"];
    }

    if (MatchTerm.collections.isFuzzyMatch(lexer.term)) {
        lexer.advanceTerm();
        return ["TaskCollection"];
    }

    if (
        MatchTerm.messages.isFuzzyMatch(lexer.term) ||
        MatchTerm.comments.isFuzzyMatch(lexer.term)
    ) {
        lexer.advanceTerm();

        return ["ChatMessage", "DocumentComment", "PostComment"];
    }

    return null;
}

export function parseEnglishNaturalLanguageSearchQuery(queryText: string) {
    // NOCOMMIT: Add account names to `compromise` lexicon

    const queryDoc = nlp(queryText);

    queryDoc.termList;

    // my documents
    const x1 = "(#Noun? #Noun? #Noun|my) ~documents~$";

    // my blue train documents
    const x2 = "^((#Noun? #Noun? (#Noun&&(#Possessive|#Plural)))|my) .+? ~documents~$";
}

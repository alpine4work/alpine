load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//admin/typescript:typescript.bzl", "ts_project")

# The `:rpc` rule has limited visibility within the `//server` directory,
# but you can use it in any test file. This alias expands visibility for
# tests only.
alias(
    name = "rpc_testonly",
    testonly = True,
    actual = ":rpc",
    visibility = [
        "//server:__subpackages__",
    ],
)

ts_project(
    name = "rpc",
    visibility = [
        "//admin/adhoc:__subpackages__",
        "//app:__subpackages__",
        "//server/remix:__subpackages__",
    ],
    deps = [
        ":all_rpc_implementations",
        "//server/accounts",
        "//server/alpha",
        "//server/apns",
        "//server/billing",
        "//server/bots",
        "//server/bots/with_spaces",
        "//server/chat/data",
        "//server/cloudflare/r2",
        "//server/content",
        "//server/databases/data",
        "//server/content/context_module",
        "//server/context",
        "//server/documents/data",
        "//server/emails",
        "//server/feed",
        "//server/files/data",
        "//server/forum/data",
        "//server/helpers",
        "//server/importer",
        "//server/importer/notion",
        "//server/integrations",
        "//server/language_models",
        "//server/messaging/drafts",
        "//server/messaging/helpers",
        "//server/notifications/data",
        "//server/opensearch",
        "//server/search/data/index",
        "//server/search/data/table",
        "//server/sites/data",
        "//server/sites/entity_actions",
        "//server/spaces",
        "//server/spaces/create",
        "//server/spell_check",
        "//server/tasks/data",

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//admin/typescript:typescript.bzl", "ts_project")

# The `:rpc` rule has limited visibility within the `//server` directory,
# but you can use it in any test file. This alias expands visibility for
# tests only.
alias(
    name = "rpc_testonly",
    testonly = True,
    actual = ":rpc",
    visibility = [
        "//server:__subpackages__",
    ],
)

ts_project(
    name = "rpc",
    visibility = [
        "//admin/adhoc:__subpackages__",
        "//app:__subpackages__",
        "//server/remix:__subpackages__",
    ],
    deps = [
        ":all_rpc_implementations",
        "//server/accounts",
        "//server/accounts/update_name",
        "//server/alpha",
        "//server/chat/data",
        "//server/content",
        "//server/context",
        "//server/documents/data",
        "//server/emails",
        "//server/forum/data",
        "//server/notifications/data",
        "//server/spaces",
        "//server/tasks/data",
        "//shared/error",
        "//shared/helpers",
        "//shared/rpc",
        "//shared/schema",
    ],
)

genrule(
    name = "all_rpc_implementations_file",
    srcs = [],
    outs = ["all_rpc_implementations.js"],
    cmd = "printf \"// @generated by //server/rpc:all_rpc_implementations_file\n\nimport \\\"../../shared/rpc/all_rpc_definitions.js\\\";\n\n{}\" > \"$@\"".format("".join([
        "import \\\"./{}.js\\\";\n".format(file[:file.rindex(".")])
        for file in glob(
            [
                "**/*.ts",
                "**/*.tsx",
            ],
            exclude = [
                "**/*.test.ts",
                "**/*.test.tsx",
                "**/*.d.ts",
                "**/*.d.tsx",
                "internal/**/*.ts",
                "internal/**/*.tsx",
                # This file imports `all_rpc_implementations.ts` so prevent cyclic import.
                "get_rpc_implementation.ts",
            ],
        )
    ])),
)

js_library(
    name = "all_rpc_implementations",
    srcs = [":all_rpc_implementations_file"],
)

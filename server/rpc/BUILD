load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//admin/typescript:typescript.bzl", "ts_project")

ts_project(
    name = "rpc",
    visibility = [
        "//app:__subpackages__",
        "//server:__subpackages__",
    ],
    deps = [
        ":all_rpc_implementations",
        "//server/dynamo",
        "//server/emails",
        "//shared/error",
        "//shared/helpers",
        "//shared/rpc",
        "//shared/schema",
    ],
)

genrule(
    name = "all_rpc_implementations_file",
    srcs = [],
    outs = ["all_rpc_implementations.js"],
    cmd = "printf \"// @generated by //server/rpc:all_rpc_implementations_file\n\nrequire(\\\"../../shared/rpc/all_rpc_definitions\\\");\n\n{}\" > \"$@\"".format("".join(["require(\\\"./{}\\\");\n".format(file[:file.rindex(".")]) for file in glob(
        [
            "**/*.ts",
            "**/*.tsx",
        ],
        exclude = [
            "**/*.test.ts",
            "**/*.test.tsx",
            "**/*.d.ts",
            "**/*.d.tsx",
            "internal/**/*.ts",
            "internal/**/*.tsx",
            # This file imports `all_rpc_implementations.ts` so prevent cyclic import.
            "get_rpc_implementation.ts",
        ],
    )])),
)

js_library(
    name = "all_rpc_implementations",
    srcs = [":all_rpc_implementations_file"],
)

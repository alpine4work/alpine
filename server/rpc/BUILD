        "//shared/schema",
        "//shared/tasks",
        "//shared/tracer",
    ],
)

ALL_RPC_IMPLEMENTATION_SRCS = glob(["*_rpc_implementations.ts"])

genrule(
    name = "all_rpc_implementations_file",
    srcs = [],
    outs = ["all_rpc_implementations.js"],
    cmd = "printf \"// @generated by //server/rpc:all_rpc_implementations_file\n\nimport {{InternalError}} from \\\"../../shared/error/error.js\\\";\nimport {{quote}} from \\\"../../shared/helpers/string/quote.js\\\";\n\n{}\nexport const allRpcImplementations = new Map();\n\nfor (const object of [\n{}]) {{\n    for (const [key, value] of Object.entries(object)) {{\n        if (allRpcImplementations.has(key)) {{\n            throw new InternalError(quote\\`Duplicate RPC implementation for \\$${{key}}\\`);\n        }}\n        allRpcImplementations.set(key, value);\n    }}\n}}\n\" > \"$@\"".format(
        "".join([
            "import rpcImplementations{} from \\\"./{}.js\\\";\n".format(
                index + 1,
                ALL_RPC_IMPLEMENTATION_SRCS[index][:ALL_RPC_IMPLEMENTATION_SRCS[index].rindex(".")],
            )
            for index in range(
                0,
                len(ALL_RPC_IMPLEMENTATION_SRCS),
            )
        ]),
        "".join([
            "    rpcImplementations{},\n".format(index + 1)
            for index in range(
                0,
                len(ALL_RPC_IMPLEMENTATION_SRCS),
            )
        ]),
    ),
)

js_library(
    name = "all_rpc_implementations",
    srcs = [
        ":all_rpc_implementations_file",
    ],
    deps = [
        "//shared/error",
        "//shared/helpers",
    ],
)

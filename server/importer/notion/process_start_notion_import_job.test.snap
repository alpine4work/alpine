        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Landscapes"
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [

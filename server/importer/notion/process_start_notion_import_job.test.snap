      },
      {
        "type": "checkListItem",
        "attrs": {
          "indent": 0,
          "checked": false
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": " Check out the "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "Todo List"
              },
              {
                "type": "text",

      },
      {
        "type": "divider"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "Geography & Nature"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Lakes"
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "Lake Superior"
              },
              {
                "type": "text",
                "text": " – cold, powerful, "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "italic"
                  }
                ],
                "text": "almost ocean-like"
              }
            ]
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "Lake Michigan"
              },
              {
                "type": "text",
                "text": " – sandy shores and dunes"
              }
            ]
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "Lake Huron"
              },
              {
                "type": "text",
                "text": " – calmer waters and island views"

          }
        ]
      },
      {
        "type": "checkListItem",
        "attrs": {
          "indent": 0,
          "checked": false
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": " "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "Find"
              },
              {
                "type": "text",
                "text": ", "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "organize"
              },
              {
                "type": "text",
                "text": ", and "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "add new pages"
              },
              {
                "type": "text",
                "text": " using the sidebar to the left 👈"

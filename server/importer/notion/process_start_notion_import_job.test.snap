        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Status: Not started"
              }
            ]
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Assignee: Josh Johnson"
              }
            ]
          }
        ]
      },
      {
        "type": "divider"
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Every item in your to do database table has a page that you can edit with content blocks (things like text, bullets, images etc.) - it’s just like editing any other document."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Try the following:"
          }
        ]
      },
      {
        "type": "checkListItem",
        "attrs": {
          "indent": 0,
          "checked": false
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": " Click anywhere and start typing"
              }
            ]
          }
        ]
      },
      {
        "type": "checkListItem",
        "attrs": {
          "indent": 0,
          "checked": false
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": " Type the "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "code"
                  }
                ],
                "text": "/"
              },
              {
                "type": "text",
                "text": " key to add all kinds of content — headers, pages, etc."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "(Here’s an "
              },
              {
                "type": "mention",
                "attrs": {
                  "mention": {
                    "type": "SearchEntity",
                    "entityId": "Document:<DOC_ID:Example sub-page>"
                  }
                }
              },
              {
                "type": "text",
                "text": "!)"
              }
            ]
          }
        ]
      },
      {
        "type": "checkListItem",
        "attrs": {
          "indent": 0,
          "checked": false
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": " Hover over this line, click and hold the : then drag to move it around"
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": " "
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "This Database is configured as a Tasks database which allows its contents to appear on your Home tab. All tasks will make their way there."
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "https://www.notion.com/help/guides/give-your-to-dos-a-home-with-task-databases"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Child documents"
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "mention",
                "attrs": {
                  "mention": {
                    "type": "SearchEntity",
                    "entityId": "Document:<DOC_ID:Example sub-page>"
                  }
                }
              }
            ]
          }
        ]
      }
    ]

                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "type "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "code"
                  },
                  {
                    "type": "bold"
                  }
                ],
                "text": "/"
              },
              {
                "type": "text",
                "text": " to see what you can create – headers, tables, to-do’s, etc."
              }

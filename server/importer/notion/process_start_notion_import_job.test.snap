        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "Old-growth forests"
              },
              {
                "type": "text",
                "text": " in the Porcupine Mountains"
              }
            ]
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "Hundreds of waterfalls"
              },
              {
                "type": "text",
                "text": " hidden in the woods"
              }
            ]
          }
        ]
      },
      {
        "type": "codeBlock",
        "attrs": {
          "language": "text"
        },
        "content": [
          {
            "type": "codeBlockLine",
            "content": [
              {
                "type": "text",
                "text": "If you love:"
              }
            ]
          },
          {
            "type": "codeBlockLine",
            "content": [
              {
                "type": "text",
                "text": "  silence"
              }
            ]
          },
          {
            "type": "codeBlockLine",
            "content": [
              {
                "type": "text",
                "text": "  stars"
              }
            ]
          },
          {
            "type": "codeBlockLine",
            "content": [
              {
                "type": "text",
                "text": "  snow"
              }
            ]
          },
          {
            "type": "codeBlockLine",
            "content": [
              {
                "type": "text",
                "text": "  shoreline"
              }
            ]
          },
          {
            "type": "codeBlockLine",
            "content": [
              {
                "type": "text",
                "text": "then the UP will feel like home."
              }
            ]
          }
        ]
      },
      {
        "type": "divider"
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "Climate"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "The UP has a "
          },
          {
            "type": "text",
            "marks": [
              {
                "type": "bold"
              }
            ],
            "text": "true northern climate"
          },
          {
            "type": "text",
            "text": ":"
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Winters are "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "long, snowy, and legendary"
              }
            ]
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Summers are "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "short, cool, and stunning"
              }
            ]
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Fall colors are "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "ridiculously vibrant"
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "marks": [
              {
                "type": "bold"
              }
            ],
            "text": "Average snowfall:"
          }
        ]
      },
      {
        "type": "codeBlock",
        "attrs": {
          "language": "text"
        },
        "content": [
          {
            "type": "codeBlockLine",
            "content": [
              {
                "type": "text",
                "text": "Some towns exceed 200 inches per year."
              }
            ]
          }
        ]
      },
      {
        "type": "divider"
      },
      {
        "type": "fileRow",
        "content": [

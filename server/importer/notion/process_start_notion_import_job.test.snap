        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Relevant coursework: Typography, Web Design, Digital Photography"
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "🚀 Projects"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "\\"EcoLife\\" Mobile App"
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "An environmentally-focused app designed to encourage sustainable living through daily challenges, tips, and community engagement."
              }

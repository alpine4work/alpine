          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "Culture"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Food"
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "Pasties"
              },
              {
                "type": "text",
                "text": " – handheld meat-and-potato pies from Cornish miners"
              }
            ]
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Fresh "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "whitefish"
              },
              {
                "type": "text",
                "text": " from Lake Superior"
              }
            ]
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Maple syrup, berries, and comfort food built for winter"
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Lifestyle"
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Slow pace"

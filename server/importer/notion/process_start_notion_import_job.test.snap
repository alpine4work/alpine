                "text": " Type "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "code"
                  }
                ],
                "text": "/page"
              },
              {
                "type": "text",
                "text": " to add a "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "new page"
              },
              {
                "type": "text",
                "text": " and nest anything, anywhere"
              }

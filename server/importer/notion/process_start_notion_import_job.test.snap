        "type": "title",
        "content": [
          {
            "type": "text",
            "text": "Getting Started"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Parent document: "
          },
          {
            "type": "mention",
            "attrs": {
              "mention": {
                "type": "SearchEntity",
                "entityId": "Document:<DOC_ID:Export>"
              }
            }
          }
        ]
      },
      {
        "type": "checkListItem",
        "attrs": {
          "indent": 0,
          "checked": true
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": " Create an account with Notion"
              }
            ]
          }
        ]
      },
      {
        "type": "checkListItem",
        "attrs": {
          "indent": 0,
          "checked": false
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": " Click anywhere below and "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "type "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "code"
                  },
                  {
                    "type": "bold"
                  }
                ],
                "text": "/"
              },
              {
                "type": "text",
                "text": " to see what you can create – headers, tables, to-do’s, etc."
              }
            ]
          }
        ]
      },
      {
        "type": "checkListItem",
        "attrs": {
          "indent": 1,
          "checked": false
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": " Type "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "code"
                  }
                ],
                "text": "/page"
              },
              {
                "type": "text",
                "text": " to add a "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "new page"
              },
              {
                "type": "text",
                "text": " and nest anything, anywhere"
              }
            ]
          }
        ]
      },
      {
        "type": "checkListItem",
        "attrs": {
          "indent": 0,
          "checked": false
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": " "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "Find"
              },
              {
                "type": "text",
                "text": ", "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "organize"
              },
              {
                "type": "text",
                "text": ", and "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "add new pages"
              },
              {
                "type": "text",
                "text": " using the sidebar to the left 👈"
              }
            ]
          }
        ]
      },
      {
        "type": "checkListItem",
        "attrs": {
          "indent": 0,
          "checked": false
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": " Check out the "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "Todo List"
              },
              {
                "type": "text",
                "text": " on the left 👈 we added for you with some more tips and tricks to best use Notion"
              }
            ]
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "This is a toggle block. Click the little triangle to see a few more useful tips!"
              }
            ]
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 1
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Click on the "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "?"
              },
              {
                "type": "text",
                "text": " in the bottom left of your screen to find "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "link",
                    "attrs": {
                      "url": "https://www.notion.com/help/guides"
                    }
                  }
                ],
                "text": "guides"
              },
              {
                "type": "text",
                "text": ", "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "link",
                    "attrs": {
                      "url": "https://www.notion.com/help/reference"
                    }
                  }
                ],
                "text": "tutorials"
              },
              {
                "type": "text",
                "text": ", and more to get your digital space configured exactly to your needs"
              }
            ]
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 1
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Click ‣ "
              },
              {
                "type": "text",
                "marks": [
                  {
                    "type": "bold"
                  }
                ],
                "text": "Marketplace"
              },
              {
                "type": "text",
                "text": " in your sidebar to try setups from our incredible community"
              }
            ]
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Here’s a circular link: "

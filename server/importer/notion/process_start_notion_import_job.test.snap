  "Personal Website": {
    "type": "doc",
    "attrs": {
      "accessPolicy": {
        "accountGrantById": {},
        "defaultGrant": null,
        "urlGrant": null
      },
      "hasPresentShortcut": false,
      "cover": null
    },
    "content": [
      {
        "type": "title",
        "content": [
          {
            "type": "text",
            "text": "Personal Website"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "Parent document: "
          },
          {
            "type": "mention",
            "attrs": {
              "mention": {
                "type": "SearchEntity",
                "entityId": "Document:<DOC_ID:Export>"
              }
            }
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": " 🎨 **Hello! I'm Ada Lee, a multidisciplinary designer based in San Francisco.** With over 8 years of experience, I thrive at the intersection of digital design, UX/UI, and brand identity. My passion lies in crafting seamless user experiences and visually compelling designs that resonate with audiences and drive engagement."
          }
        ]
      },
      {
        "type": "fileRow",
        "content": [
          {
            "type": "file",
            "attrs": {
              "fileId": "<FILE_ID:10>"
            }
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "🌈 About Me"
          }
        ]
      },
      {
        "type": "paragraph",
        "content": [
          {
            "type": "text",
            "text": "I'm a creative thinker, a problem solver, and an avid learner, always exploring new trends and techniques in design. When I'm not pushing pixels, you can find me with a sketchbook, capturing the world or lost in the pages of a good design book."
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "💼 Experience"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Senior UX/UI Designer - Creative Minds Inc. | June 2018 - Present"
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Lead the design of intuitive user interfaces for mobile and web applications, enhancing user satisfaction and engagement."
              }
            ]
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Collaborate with cross-functional teams to create cohesive brand experiences across all platforms."
              }
            ]
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Mentor junior designers, fostering a collaborative and innovative design culture."
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Graphic Designer - BrandWorks Agency | Jan 2014 - May 2018"
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Developed brand identities, including logos, typography, and color schemes, for over 30 clients."
              }
            ]
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Produced marketing materials, digital ads, and promotional content, resulting in a 25% increase in client engagement for key accounts."
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 1
        },
        "content": [
          {
            "type": "text",
            "text": "🎓 Education"
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Master of Fine Arts in Design - Rhode Island School of Design | 2013"
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Specialized in Digital + Media"
              }
            ]
          }
        ]
      },
      {
        "type": "unorderedListItem",
        "attrs": {
          "indent": 0
        },
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Thesis: \\"Interactivity and User Engagement in Digital Platforms\\""
              }
            ]
          }
        ]
      },
      {
        "type": "heading",
        "attrs": {
          "level": 2
        },
        "content": [
          {
            "type": "text",
            "text": "Bachelor of Arts in Graphic Design - University of California, Berkeley | 2011"
          }
        ]
      },
      {

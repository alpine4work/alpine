{
    /* ========================================================================== *\
     *                                  General                                   *
    \* ========================================================================== */

    "editor.insertSpaces": true,
    "editor.tabSize": 4,
    "editor.rulers": [100],
    "editor.wordWrap": "off",
    "editor.formatOnSave": true,
    "editor.unicodeHighlight.allowedCharacters": {
        "‘": true,
        "’": true,
        "“": true,
        "”": true
    },
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.associations": {
        ".env*": "properties"
    },
    // Bazel creates a lot of symlinks. We were seeing really slow `rg` executions in
    // process manager with this set to `true`.
    "search.followSymlinks": false,

    // To enable file nesting, add this to your personal settings:
    //
    // ```
    // "explorer.fileNesting.enabled": true,
    // ```
    "explorer.fileNesting.expand": true,
    "explorer.fileNesting.patterns": {
        "*.py": "${capture}.py, test_${capture}.py, ${capture}_test.py",
        "*.js": "${basename}.test.js,${basename}.spec.js,${basename}.test.ts,${basename}.spec.ts,${basename}.test.jsx,${basename}.spec.jsx,${basename}.test.tsx,${basename}.spec.tsx, ${capture}.js.map, ${capture}.min.js, ${capture}.d.ts,${basename}.test.snap",
        "*.ts": "${basename}.test.js,${basename}.spec.js,${basename}.test.ts,${basename}.spec.ts,${basename}.test.jsx,${basename}.spec.jsx,${basename}.test.tsx,${basename}.spec.tsx,${basename}.test.snap",
        "*.jsx": "${basename}.test.js,${basename}.spec.js,${basename}.test.ts,${basename}.spec.ts,${basename}.test.jsx,${basename}.spec.jsx,${basename}.test.tsx,${basename}.spec.tsx,${basename}.test.snap",
        "*.tsx": "${basename}.test.js,${basename}.spec.js,${basename}.test.ts,${basename}.spec.ts,${basename}.test.jsx,${basename}.spec.jsx,${basename}.test.tsx,${basename}.spec.tsx,${basename}.test.snap",
        "package.json": ".eslint*,.npmrc,prettier.config.cjs,.prettierignore,pnpm-lock.yaml,playwright.config.cjs,package_light.json,vite.config.mjs,jest.config.cjs",
        "requirements.txt": "requirements_lock.txt",
        ".bazelrc": ".bazel*",
        ".env": ".env*",
        "cdk.json": "cdk*"
    },

    /* ========================================================================== *\
     *                                TypeScript                                  *
    \* ========================================================================== */

    "typescript.tsdk": "./node_modules/typescript/lib",
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "javascript.preferences.importModuleSpecifier": "non-relative",
    "typescript.preferences.importModuleSpecifier": "non-relative",

    /* ========================================================================== *\
     *                                 Markdown                                   *
    \* ========================================================================== */

    "[markdown]": {
        "editor.wordWrap": "wordWrapColumn",
        "editor.wordWrapColumn": 100
    },

    /* ========================================================================== *\
     *                                   Swift                                    *
    \* ========================================================================== */

    "swift.sourcekit-lsp.serverArguments": [
        // Override Swift SDK:
        "-Xswiftc",
        "-sdk",
        "-Xswiftc",
        "/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator17.2.sdk",

        // Override C sysroot to match SDK:
        "-Xcc",
        "-isysroot",
        "-Xcc",
        "/Applications/Xcode.app/Contents/Developer/Platforms/iPhoneSimulator.platform/Developer/SDKs/iPhoneSimulator17.2.sdk",

        // Override Swift target triple:
        "-Xswiftc",
        "-target",
        "-Xswiftc",
        "x86_64-apple-ios17.2-simulator"
    ],

    // Unfortunately the plugin requires this property to be configured at a user
    // level. So add an absolute path to the vendored `swift-format` binary to your
    // personal `settings.json` file. e.g.
    // `/Users/calebmer/Projects/cyberworlds/admin/vendor/swift-format/swift-format`.
    // The setting must be an array.
    //
    // "apple-swift-format.path": ["./admin/vendor/swift-format/swift-format"]

    "apple-swift-format.configSearchPaths": ["native/mobile/ios/swift_format_config.json"]
}

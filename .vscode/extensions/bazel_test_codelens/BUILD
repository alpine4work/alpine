load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("//admin/typescript:typescript.bzl", "ts_project")

ts_project(
    name = "bazel_test_codelens",
    module = "commonjs",
    deps = [
        "//:node_modules/@types/node",
        "//:node_modules/@types/vscode",
    ],
)

SRCS = [file[4:-3] for file in glob(["src/**/*.ts"])]

genrule(
    name = "outs",
    srcs = ["src/{}.js".format(src) for src in SRCS],
    outs = ["src/{}_out.js".format(src) for src in SRCS],
    cmd = """
srcs_array=($(SRCS))
outs_array=($(OUTS))

for i in "$${!srcs_array[@]}"; do
    src="$${srcs_array[$$i]}"
    out="$${outs_array[$$i]}"

    # Remove source map and all single line comments. We don't write source map to our git repo.
    sed '/^[[:space:]]*$$/{N;/\\n\\/\\/# sourceMappingURL/d;};/^\\/\\/# sourceMappingURL/d' "$$src" | \
    sed '/^[[:space:]]*\\/\\/.*$$/d' > "$$out.tmp"

    # Add comment letting the reader know the file is generated.
    {
        echo "// @generated by //.vscode/extensions/bazel_test_codelens:write_outs"
        echo "/* eslint-disable */"
        echo
        cat "$$out.tmp"
    } > "$$out"

    rm "$$out.tmp"
done
""",
)

write_source_files(
    name = "write_outs",
    files = {"out/{}.js".format(src): "src/{}_out.js".format(src) for src in SRCS},
)

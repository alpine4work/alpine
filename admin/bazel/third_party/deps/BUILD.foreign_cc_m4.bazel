# Originally copied from:
# https://github.com/bazelbuild/rules_foreign_cc/blob/d9367d28ad5292dd2ed42ae85223e79e845d0f3f/examples/third_party/autotools/BUILD.m4.bazel

load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all_srcs",
    srcs = glob(
        include = ["**"],
        exclude = ["*.bazel"],
    ),
)

configure_make(
    name = "m4",
    env = select({
        "@platforms//os:macos": {"AR": ""},
        "//conditions:default": {},
    }),
    lib_source = ":all_srcs",
    out_binaries = ["m4"],
    out_data_dirs = ["lib/pkgconfig"],
)

filegroup(
    name = "m4_exe",
    srcs = [":m4"],
    output_group = "m4",
    visibility = ["//visibility:public"],
)

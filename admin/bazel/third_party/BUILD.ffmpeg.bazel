# TODO: Currently, building `@ffmpeg` is not 100% hermetic. List of known
# issues we need to fix to make it fully hermetic:
#
# - `make` must be installed globally for building packages with `make` (this
#   means `apt-get install build-essential` on Linux machines).
#
# - On MacOS machines we use the system `gcc` compiler when compiling `@ffmpeg`
#   for linking because it supports the `-dynamic` flag.
genrule(
    name = "ffmpeg",
    srcs = [
        "@libaom",
        "@libopus",
        "@libvpx",
        "@openssl",
        "@pkg_config",
        "@zlib",
    ] + glob(
        include = ["**"],
        exclude = [
            # Exclude dot-files like `.DS_Store` on MacOS.
            ".*",
            # Exclude test files.
            "tests/**",
            # Exclude documentation files.
            "doc/**",
        ],
    ) + [
        # Needed for `make install` even though we disabled building documentation.
        "doc/ffprobe.xsd",
    ],
    outs = [
        "install/bin/ffmpeg",
        "install/bin/ffprobe",
    ],
    # Notes:
    #
    # - `--disable-autodetect` is passed so we don't build with packages on the
    #   system which won't create a hermetic build.
    #
    # - We set `--prefix` relative to the current directory which is in a sandbox.
    #   We replace references to the sandbox path with the string
    #   `${bazel_sandbox}`. Commands that use config files must replace
    #   `${bazel_sandbox}` with the path to their own Bazel sandbox.
    #
    # - We replace the Bazel sandbox path in `config.h` with `${bazel_sandbox}` to
    #   obfuscate the implementation detail of where FFmpeg was built.
    #
    # - On MacOS, we use the system installed linker for `CC_LD` instead of `zig`.
    #   FFmpeg adds `-dynamic` to linker flags on MacOS which is not supported by
    #   `zig ld.lld`. Is this an issue with FFmpeg or with `zig`? Not sure. From
    #   some brief research it looks like the `-dynamic` option is only supported
    #   by Apple's linker.
    #
    #   We need to pass the compiler program into FFmpeg's `--ld` option since it
    #   passes arguments via `-Wl`. e.g. `-Wl,-dynamic`.
    cmd = """
platform_name="$$(uname -s | tr '[:upper:]' '[:lower:]')"

export ZIG_LOCAL_CACHE_DIR="$$(pwd)/$(RULEDIR)/zig-local-cache"
export ZIG_GLOBAL_CACHE_DIR="$$(pwd)/$(RULEDIR)/zig-global-cache"
export CC="$$(pwd)/$(location @//:zig) cc"
export CXX="$$(pwd)/$(location @//:zig) c++"
export AR="$$(pwd)/$(location @//:zig) ar"
export LD="$$(pwd)/$(location @//:zig) ld.lld"

if [ "$$platform_name" == "darwin" ]; then
    export CC_LD=gcc
else
    export CC_LD="$$(pwd)/$(location @//:zig) cc"
fi

export CFLAGS+=" -O3 -fPIC"

bazel_sandbox=$$(pwd)

cd $(RULEDIR)

echo "# ========================================================================== #" >> cmd.log
echo "#                                 configure                                  #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

mkdir pkgconfig
cp ../libaom/install/lib/pkgconfig/aom.pc pkgconfig/aom.pc
cp ../libopus/install/lib/pkgconfig/opus.pc pkgconfig/opus.pc
cp ../libvpx/install/lib/pkgconfig/vpx.pc pkgconfig/vpx.pc
cp ../openssl/install/lib/pkgconfig/openssl.pc pkgconfig/openssl.pc
cp ../openssl/install/lib/pkgconfig/libssl.pc pkgconfig/libssl.pc
cp ../openssl/install/lib/pkgconfig/libcrypto.pc pkgconfig/libcrypto.pc
cp ../zlib/install/lib/pkgconfig/zlib.pc pkgconfig/zlib.pc

escaped_bazel_sandbox=$$(echo -n "$$bazel_sandbox" | sed -e 's/[\\/&]/\\\\&/g')
sed -i.bak "s/\\$${bazel_sandbox}/$$escaped_bazel_sandbox/g" pkgconfig/*

PKG_CONFIG_PATH="$$(pwd)/pkgconfig" \\
    "$$bazel_sandbox/$(location configure)" \\
    "--cc=$$CC" \\
    "--cxx=$$CXX" \\
    "--ar=$$AR" \\
    "--ld=$$CC_LD" \\
    "--prefix=$$(pwd)/install" \\
    "--pkg-config=$$(pwd)/../pkg_config/install/bin/pkg-config" \\
    --pkg-config-flags=--static \\
    --enable-static \\
    --disable-shared \\
    --disable-autodetect \\
    --disable-ffplay \\
    --disable-doc \\
    --disable-htmlpages \\
    --disable-manpages \\
    --disable-podpages \\
    --disable-txtpages \\
    --disable-debug \\
    --enable-libaom \\
    --enable-libopus \\
    --enable-libvpx \\
    --enable-decoder=png \\
    --enable-zlib \\
    --enable-openssl \\
    >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

sed -i.bak "s/$$escaped_bazel_sandbox/\\$${bazel_sandbox}/g" config.h

echo "# ========================================================================== #" >> cmd.log
echo "#                                    make                                    #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

make --jobs=6 >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

echo >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo "#                                make install                                #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

make --jobs=6 install >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)
""",
    tags = ["cpu:6"],
    tools = ["@//:zig"],
    visibility = ["//visibility:public"],
)

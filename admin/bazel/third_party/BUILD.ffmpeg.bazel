genrule(
    name = "ffmpeg",
    srcs = [
        "@pkg_config",
        "@libaom",
        "@libopus",
        "@libvpx",
        "@zlib",
    ] + glob(
        include = ["**"],
        exclude = [
            # Exclude dot-files like `.DS_Store` on MacOS.
            ".*",
            # Exclude test files.
            "tests/**",
            # Exclude documentation files.
            "doc/**",
        ],
    ) + [
        # Needed for `make install` even though we disabled building documentation.
        "doc/ffprobe.xsd",
    ],
    outs = [
        "install/bin/ffmpeg",
        "install/bin/ffprobe",
    ],
    # Notes:
    #
    # - `--disable-autodetect` is passed so we don't build with packages on the
    #   system which won't create a hermetic build.
    #
    # - `--pkg-config=false` is passed so we don't build with packages on the
    #   system discovered by `pkg-config`. The `false` executable always exits with
    #   code 1.
    #
    # - We set `--prefix` relative to the current directory which is in a sandbox.
    #   We replace references to the sandbox path with the string
    #   `${bazel_sandbox}`. Commands that use config files must replace
    #   `${bazel_sandbox}` with the path to their own Bazel sandbox.
    #
    # - We replace the Bazel sandbox path in `config.h` with `${bazel_sandbox}` to
    #   obfuscate the implementation detail of where FFmpeg was built.
    cmd = """
export ZIG_LOCAL_CACHE_DIR="$$(pwd)/$(RULEDIR)/zig-local-cache"
export ZIG_GLOBAL_CACHE_DIR="$$(pwd)/$(RULEDIR)/zig-global-cache"
export CC="$$(pwd)/$(location @//:zig) cc"
export AR="$$(pwd)/$(location @//:zig) ar"
export LD="$$(pwd)/$(location @//:zig) ld.lld"
export CFLAGS=""
export ARFLAGS=""
export LDFLAGS=""

bazel_sandbox=$$(pwd)

cd $(RULEDIR)

echo "# ========================================================================== #" >> cmd.log
echo "#                                 configure                                  #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

mkdir pkgconfig
cp ../libvpx/install/lib/pkgconfig/vpx.pc pkgconfig/vpx.pc
cp ../libopus/install/lib/pkgconfig/opus.pc pkgconfig/opus.pc
cp ../libaom/install/lib/pkgconfig/aom.pc pkgconfig/aom.pc
cp ../zlib/install/lib/pkgconfig/zlib.pc pkgconfig/zlib.pc

escaped_bazel_sandbox=$$(echo -n "$$bazel_sandbox" | sed -e 's/[\\/&]/\\\\&/g')
sed -i.bak "s/\\$${bazel_sandbox}/$$escaped_bazel_sandbox/g" pkgconfig/*

PKG_CONFIG_PATH="$$(pwd)/pkgconfig" \\
    "$$bazel_sandbox/$(location configure)" \\
    "--prefix=$$(pwd)/install" \\
    "--pkg-config=$$(pwd)/../pkg_config/install/bin/pkg-config" \\
    --pkg-config-flags=--static \\
    --enable-static \\
    --disable-shared \\
    --disable-autodetect \\
    --disable-ffplay \\
    --disable-doc \\
    --disable-htmlpages \\
    --disable-manpages \\
    --disable-podpages \\
    --disable-txtpages \\
    --enable-libaom \\
    --enable-libopus \\
    --enable-libvpx \\
    --enable-decoder=png \\
    --enable-zlib \\
    >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

sed -i.bak "s/$$escaped_bazel_sandbox/\\$${bazel_sandbox}/g" config.h

echo "# ========================================================================== #" >> cmd.log
echo "#                                    make                                    #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

make --jobs=6 >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

echo >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo "#                                make install                                #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

make --jobs=6 install >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)
""",
    tags = ["cpu:6"],
    tools = ["@//:zig"],
    visibility = ["//visibility:public"],
)

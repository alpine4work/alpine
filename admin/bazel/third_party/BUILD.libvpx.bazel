load("@//admin/bazel:third_party/zig_target_cpu_flags.bzl", "zig_target_cpu_flags")

genrule(
    name = "libvpx",
    srcs = ["@nasm"] + glob(
        include = ["**"],
        # Exclude dot-files like `.DS_Store` on MacOS.
        exclude = [".*"],
    ),
    outs = [
        "install/include/vpx/vpx_image.h",
        "install/include/vpx/vpx_encoder.h",
        "install/include/vpx/vpx_tpl.h",
        "install/include/vpx/vp8cx.h",
        "install/include/vpx/vpx_integer.h",
        "install/include/vpx/vpx_codec.h",
        "install/include/vpx/vp8.h",
        "install/include/vpx/vp8dx.h",
        "install/include/vpx/vpx_ext_ratectrl.h",
        "install/include/vpx/vpx_decoder.h",
        "install/include/vpx/vpx_frame_buffer.h",
        "install/lib/pkgconfig/vpx.pc",
        "install/lib/libvpx.a",
    ],
    # Notes:
    #
    # - `nasm` is required on x86_64 Linux machines. We've built our own copy of
    #   `nasm` and add it to the path for `libvpx` to find. It's probably ok if we
    #   use Bazel `select()` to only build `nasm` on x86_64 machines. However, we
    #   unconditionally build `nasm` to test in CI that we haven't accidentally
    #   introduced a regression into the `nasm` build.
    cmd = """
export ZIG_LOCAL_CACHE_DIR="$$(pwd)/$(RULEDIR)/zig-local-cache"
export ZIG_GLOBAL_CACHE_DIR="$$(pwd)/$(RULEDIR)/zig-global-cache"
export CC="$$(pwd)/$(location @//:zig) cc"
export CXX="$$(pwd)/$(location @//:zig) c++"
export AR="$$(pwd)/$(location @//:zig) ar"
export LD="$$(pwd)/$(location @//:zig) ld.lld"
export CFLAGS+=" -O3 -fPIC"
""" + zig_target_cpu_flags() + """

bazel_sandbox=$$(pwd)

cd $(RULEDIR)

export PATH="$$(pwd)/../nasm/install/bin:$$PATH"

echo "# ========================================================================== #" >> cmd.log
echo "#                                 configure                                  #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

"$$bazel_sandbox/$(location configure)" \\
    "--prefix=$$(pwd)/install" \\
    --disable-examples \\
    --disable-tools \\
    --disable-docs \\
    --enable-vp9 \\
    >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

echo "# ========================================================================== #" >> cmd.log
echo "#                                    make                                    #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

make --jobs=6 >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

echo >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo "#                                make install                                #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

make --jobs=6 install >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

escaped_bazel_sandbox=$$(echo -n "$$bazel_sandbox" | sed -e 's/[\\/&]/\\\\&/g')
sed -i.bak "s/$$escaped_bazel_sandbox/\\$${bazel_sandbox}/g" install/lib/pkgconfig/vpx.pc
""",
    tags = ["cpu:6"],
    tools = ["@//:zig"],
    visibility = ["//visibility:public"],
)

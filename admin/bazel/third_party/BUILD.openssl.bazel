    # Notes:
    #
    # - Annoyingly on x86_64 Linux machines OpenSSL puts files in the `install/lib`
    #   directory in `install/lib64` instead. Setting `--libdir=lib` should fix
    #   this.
    cmd = """
export ZIG_LOCAL_CACHE_DIR="$$(pwd)/$(RULEDIR)/zig-local-cache"
export ZIG_GLOBAL_CACHE_DIR="$$(pwd)/$(RULEDIR)/zig-global-cache"
export CC="$$(pwd)/$(location @//:zig) cc"
export CXX="$$(pwd)/$(location @//:zig) c++"
export AR="$$(pwd)/$(location @//:zig) ar"
export LD="$$(pwd)/$(location @//:zig) ld.lld"
export CFLAGS+=" -O3 -fPIC"

bazel_sandbox=$$(pwd)

cd $(RULEDIR)

echo "# ========================================================================== #" >> cmd.log
echo "#                                 configure                                  #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

"$$bazel_sandbox/$(location Configure)" \\
    "--prefix=$$(pwd)/install" \\
    --libdir=lib \\
    no-apps \\
    no-docs \\
    no-tests \\
    no-shared \\
    no-legacy \\
    >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

echo "# ========================================================================== #" >> cmd.log
echo "#                                    make                                    #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

make --jobs=6 >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

echo >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo "#                                make install                                #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

make --jobs=6 install >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

escaped_bazel_sandbox=$$(echo -n "$$bazel_sandbox" | sed -e 's/[\\/&]/\\\\&/g')
sed -i.bak "s/$$escaped_bazel_sandbox/\\$${bazel_sandbox}/g" install/lib/pkgconfig/openssl.pc install/lib/pkgconfig/libssl.pc install/lib/pkgconfig/libcrypto.pc
""",
    tags = ["cpu:6"],
    tools = ["@//:zig"],
    visibility = ["//visibility:public"],
)

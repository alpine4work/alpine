genrule(
    name = "pkg_config",
    # We don't use `copy_to_bin()` because we want file timestamps to be preserved
    # so `make` doesn't try to rebuild files that haven't changed. We'll perform an
    # out-of-tree build of `pkg-config` in Bazel's bin directory.
    srcs = glob(
        include = ["**"],
        # Exclude dot-files like `.DS_Store` on MacOS.
        exclude = [".*"],
    ),
    # Our installation directory is `install2` instead of `install` since there's
    # an existing `INSTALL` file so Bazel won't create an `install` directory.
    outs = [
        "install2/bin/pkg-config",
        "install2/share/man/man1/pkg-config.1",
        "install2/share/aclocal/pkg.m4",
        "install2/share/doc/pkg-config/pkg-config-guide.html",
    ],
    cmd = """
bazel_sandbox=$$(pwd)

cd $(RULEDIR)

echo "# ========================================================================== #" >> cmd.log
echo "#                                 configure                                  #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

"$$bazel_sandbox/$(location configure)" \\
    "--prefix=$$(pwd)/install2" \\
    --disable-debug \\
    --disable-host-tool \\
    --with-internal-glib \\
    >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

echo "# ========================================================================== #" >> cmd.log
echo "#                                    make                                    #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

make --jobs=6 >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

echo >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo "#                                make install                                #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

make --jobs=6 install-strip >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)
""",
    tags = ["cpu:6"],
    visibility = ["//visibility:public"],
)

genrule(
    name = "pkg_config",
    srcs = glob(
        include = ["**"],
        # Exclude dot-files like `.DS_Store` on MacOS.
        exclude = [".*"],
    ),
    outs = [
        "install/bin/pkg-config",
        "install/share/man/man1/pkg-config.1",
        "install/share/aclocal/pkg.m4",
        "install/share/doc/pkg-config/pkg-config-guide.html",
    ],
    cmd = """
bazel_sandbox=$$(pwd)

cd $(RULEDIR)

echo "# ========================================================================== #" >> cmd.log
echo "#                                 configure                                  #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

# Update the modification timestamp of all symlinks to the modification time of the
# target file. This way `make` won't rebuild targets that haven't changed.
# Importantly for `pkg-config`, rebuilding `aclocal.m4` requires autoconf to be
# installed which we don't currently have.
find "$$(dirname $$bazel_sandbox/$(location configure))" -type l -print0 | while IFS= read -r -d '' symlink; do
    target=$$(readlink -f "$$symlink")
    target_mtime=$$(date -r "$$target" "+%Y%m%d%H%M.%S")
    touch -h -t "$$target_mtime" "$$symlink"
done

"$$bazel_sandbox/$(location configure)" \\
    "--prefix=$$(pwd)/install" \\
    --disable-debug \\
    --disable-host-tool \\
    --with-internal-glib \\
    >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

echo "# ========================================================================== #" >> cmd.log
echo "#                                    make                                    #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

make --jobs=6 >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

echo >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo "#                                make install                                #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

make --jobs=6 install-strip >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)
""",
    tags = ["cpu:6"],
    visibility = ["//visibility:public"],
)

load("@//admin/bazel:third_party/zig_target_cpu_flags.bzl", "zig_target_cpu_flags")

genrule(
    name = "libaom",
    srcs = ["@nasm"] + glob(
        include = ["**"],
        # Exclude dot-files like `.DS_Store` on MacOS.
        exclude = [".*"],
    ),
    outs = [
        "install/include/aom/aomdx.h",
        "install/include/aom/aom_frame_buffer.h",
        "install/include/aom/aom_encoder.h",
        "install/include/aom/aom_integer.h",
        "install/include/aom/aom.h",
        "install/include/aom/aom_external_partition.h",
        "install/include/aom/aom_image.h",
        "install/include/aom/aom_codec.h",
        "install/include/aom/aom_decoder.h",
        "install/include/aom/aomcx.h",
        "install/lib/pkgconfig/aom.pc",
        "install/lib/libaom.a",
    ],
    # Notes:
    #
    # - We need `-mcrc32` in `CFLAGS` on x86_64 Linux machines. x86_64 machines
    #   have a hardware crc32 instruction but it must be explicitly enabled with
    #   the `-mcrc32` flag.
    #
    # - We set `CMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER`,
    #   `CMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY`, and
    #   `CMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY` because that's how
    #   [`sharp-libvips`][1] does it. Seems like this options will make the build more
    #   hermetic.
    #
    # - `nasm` is required on x86_64 Linux machines. We've built our own copy of
    #   `nasm` and add it to the path for `libvpx` to find. It's probably ok if we
    #   use Bazel `select()` to only build `nasm` on x86_64 machines. However, we
    #   unconditionally build `nasm` to test in CI that we haven't accidentally
    #   introduced a regression into the `nasm` build.
    #
    # [1]: https://github.com/cyberworlds/sharp-libvips/blob/13d4e523ed4690a77854827e905bc620992444de/platforms/linux-x64/Toolchain.cmake#L1-L3
    cmd = """
arch_name="$$(uname -m)"
if [ "$$arch_name" = "amd64" ]; then
    arch_name="x86_64"
fi
if [ "$$arch_name" = "aarch64" ]; then
    arch_name="arm64"
fi

export ZIG_LOCAL_CACHE_DIR="$$(pwd)/$(RULEDIR)/zig-local-cache"
export ZIG_GLOBAL_CACHE_DIR="$$(pwd)/$(RULEDIR)/zig-global-cache"
export CC="$$(pwd)/$(location @//:zig) cc"
export CXX="$$(pwd)/$(location @//:zig) c++"
export AR="$$(pwd)/$(location @//:zig) ar"
export LD="$$(pwd)/$(location @//:zig) ld.lld"
export CFLAGS+=" -O3 -fPIC"
""" + zig_target_cpu_flags() + """

if [ "$$arch_name" = "x86_64" ]; then
    export CFLAGS+=" -mcrc32"
fi

bazel_sandbox=$$(pwd)

cd $(RULEDIR)

export PATH="$$(pwd)/../nasm/install/bin:$$PATH"

echo "# ========================================================================== #" >> cmd.log
echo "#                                   cmake                                    #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

"$$bazel_sandbox/$(location @//:cmake)" \\
    -G"Unix Makefiles" \\
    -DCMAKE_FIND_ROOT_PATH_MODE_PROGRAM=NEVER \\
    -DCMAKE_FIND_ROOT_PATH_MODE_LIBRARY=ONLY \\
    -DCMAKE_FIND_ROOT_PATH_MODE_INCLUDE=ONLY \\
    "-DCMAKE_INSTALL_PREFIX=$$(pwd)/install" \\
    -DCMAKE_INSTALL_LIBDIR=lib \\
    -DCMAKE_BUILD_TYPE=Release \\
    -DBUILD_SHARED_LIBS=FALSE \\
    -DENABLE_DOCS=0 \\
    -DENABLE_TESTS=0 \\
    -DENABLE_TESTDATA=0 \\
    -DENABLE_TOOLS=0 \\
    -DENABLE_EXAMPLES=0 \\
    "$$(dirname $$bazel_sandbox/$(location CMakeLists.txt))" \\
    >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

echo >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo "#                             make install/strip                             #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

make --jobs=6 install/strip >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

escaped_bazel_sandbox=$$(echo -n "$$bazel_sandbox" | sed -e 's/[\\/&]/\\\\&/g')
sed -i.bak "s/$$escaped_bazel_sandbox/\\$${bazel_sandbox}/g" install/lib/pkgconfig/aom.pc
""",
    tags = ["cpu:6"],
    tools = [
        "@//:cmake",
        "@//:zig",
    ],
    visibility = ["//visibility:public"],
)

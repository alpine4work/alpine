genrule(
    name = "libopus",
    srcs = glob(
        include = ["**"],
        # Exclude dot-files like `.DS_Store` on MacOS.
        exclude = [".*"],
    ),
    outs = [
        "install/include/opus/opus.h",
        "install/include/opus/opus_multistream.h",
        "install/include/opus/opus_types.h",
        "install/include/opus/opus_defines.h",
        "install/include/opus/opus_projection.h",
        "install/lib/pkgconfig/opus.pc",
        "install/lib/libopus.la",
        "install/lib/libopus.a",
        "install/share/aclocal/opus.m4",
    ],
    cmd = """
bazel_sandbox=$$(pwd)

cd $(RULEDIR)

echo "# ========================================================================== #" >> cmd.log
echo "#                                 configure                                  #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

"$$bazel_sandbox/$(location configure)" \\
    "--prefix=$$(pwd)/install" \\
    --disable-maintainer-mode \\
    --disable-shared \\
    --enable-static \\
    --disable-doc \\
    --disable-extra-programs \\
    >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

echo "# ========================================================================== #" >> cmd.log
echo "#                                    make                                    #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

make --jobs=6 >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

echo >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo "#                                make install                                #" >> cmd.log
echo "# ========================================================================== #" >> cmd.log
echo >> cmd.log

make --jobs=6 install-strip >> cmd.log 2>> cmd.log || (cat cmd.log && exit 1)

escaped_bazel_sandbox=$$(echo -n "$$bazel_sandbox" | sed -e 's/[\\/&]/\\\\&/g')
sed -i.bak "s/$$escaped_bazel_sandbox/\\$${bazel_sandbox}/g" install/lib/pkgconfig/opus.pc
""",
    tags = ["cpu:6"],
    visibility = ["//visibility:public"],
)

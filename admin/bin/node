#!/bin/bash

workspace_path=$(cd $(dirname $0)/../.. && pwd)

# If we are in our workspace then run `node` through Bazel so we get the right
# version. Otherwise, remove our workspace bin from `PATH` to run the system
# installed `node`.
if [[ $PWD/ = $workspace_path/* ]]; then
    platform_name="$(uname -s | tr '[:upper:]' '[:lower:]')"

    arch_name="$(uname -m)"
    if [ "$arch_name" = "x86_64" ]; then
        arch_name="amd64"
    fi
    if [ "$arch_name" = "aarch64" ]; then
        arch_name="arm64"
    fi

    node_workspace="nodejs_${platform_name}_${arch_name}"
    output_base="$(bazel info output_base)"
    "$workspace_path/admin/bin/bazel" build --ui_event_filters=-info "@$node_workspace//:bin/node"
    "$output_base/external/$node_workspace/bin/node" "$@"
else
    workspace_bin_path=$workspace_path/admin/bin

    PATH=:$PATH:
    PATH=${PATH//:$workspace_bin_path:/:}
    PATH=${PATH#:}
    export PATH=${PATH%:}

    node "$@"
fi

#!/bin/bash

# Worktree support: search up from the current directory for a `cyberworlds`
# checkout. If we find one with a different `admin/bin/node` script, run that
# instead. Skip if we're in Bazel's output directory since the execroot
# mirrors the source tree and we'd find `admin/bin` scripts there.
if [[ "$(pwd -P)" != *"/_bazel_"* ]]; then
    search_dir="$PWD"
    while [ "$search_dir" != "/" ]; do
        if [ -x "$search_dir/admin/bin/node" ]; then
            this_script=$(cd "$(dirname "$0")" && pwd -P)/node
            found_script=$(cd "$search_dir/admin/bin" && pwd -P)/node
            if [ "$this_script" != "$found_script" ]; then
                exec "$search_dir/admin/bin/node" "$@"
            fi
            break
        fi
        search_dir=$(dirname "$search_dir")
    done
fi

workspace_path=$(cd $(dirname $0)/../.. && pwd)

# If we are in our workspace then run `node` through Bazel so we get the right
# version. Otherwise, remove our workspace bin from `PATH` to run the system
# installed `node`.
if [[ $PWD/ = $workspace_path/* ]]; then
    platform_name="$(uname -s | tr '[:upper:]' '[:lower:]')"

    arch_name="$(uname -m)"
    if [ "$arch_name" = "x86_64" ]; then
        arch_name="amd64"
    fi
    if [ "$arch_name" = "aarch64" ]; then
        arch_name="arm64"
    fi

    node_workspace="nodejs_${platform_name}_${arch_name}"
    output_base="$(bazel info output_base)"
    "$workspace_path/admin/bin/bazel" build --ui_event_filters=-info "@$node_workspace//:bin/node"
    "$output_base/external/$node_workspace/bin/node" "$@"
else
    workspace_bin_path=$workspace_path/admin/bin

    PATH=:$PATH:
    PATH=${PATH//:$workspace_bin_path:/:}
    PATH=${PATH#:}
    export PATH=${PATH%:}

    node "$@"
fi

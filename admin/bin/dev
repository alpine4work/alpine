#!/bin/bash

workspace_path=$(cd $(dirname $0)/../.. && pwd)
cd $workspace_path

case "$1" in
    check)
        files="$(git diff --name-only main | grep -E '\.tsx?$' | xargs | sed "s/ / union /g")"

        if [ -z "$files" ]; then
            echo "No changed files"
        else
            bazel query --noshow_progress "tests(rdeps(attr(tags, '\bdev-check\b', tests(//...)), $files))" | xargs bazel test
        fi
        ;;

    test)
        files="$(git diff --name-only main | grep -E '\.tsx?$' | xargs | sed "s/ / union /g")"

        if [ -z "$files" ]; then
            echo "No changed files"
        else
            bazel query --noshow_progress "tests(rdeps(attr(tags, '\bdev-test\b', tests(//...)), $files))" | xargs bazel test
        fi
        ;;

    *)
        ./admin/bin/bazel run --ui_event_filters=-info //admin/dev
        ;;
esac


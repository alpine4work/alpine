#!/bin/bash

workspace_path=$(cd $(dirname $0)/../.. && pwd)
cd $workspace_path

# TODO(calebmer): `dev test` and `dev check` command. They look at all git
# modified files and runs tests (`dev test`) or TypeScript/eslint/Prettier
# (`dev check`) for those files. If you pass a file path then instead of
# looking at git modified files we'll test/check just that path.

bazel run --ui_event_filters=-info //admin/dev

#!/bin/bash

set -e

# Worktree support: search up from the current directory for a `cyberworlds`
# checkout. If we find one with a different `admin/bin/dev` script, run that
# instead. Skip if we're in Bazel's output directory since the execroot
# mirrors the source tree and we'd find `admin/bin` scripts there.
if [[ "$(pwd -P)" != *"/_bazel_"* ]]; then
    search_dir="$PWD"
    found_workspace=false
    while [ "$search_dir" != "/" ]; do
        if [ -x "$search_dir/admin/bin/dev" ]; then
            this_script=$(cd "$(dirname "$0")" && pwd -P)/dev
            found_script=$(cd "$search_dir/admin/bin" && pwd -P)/dev
            if [ "$this_script" != "$found_script" ]; then
                exec "$search_dir/admin/bin/dev" "$@"
            fi
            found_workspace=true
            break
        fi
        search_dir=$(dirname "$search_dir")
    done
    if [ "$found_workspace" = false ]; then
        echo 'Error: Not in a `cyberworlds` checkout' >&2
        exit 1
    fi
fi

base_path=$(pwd)
workspace_path=$(cd $(dirname $0)/../.. && pwd)
cd $workspace_path

# Adapted from: https://stackoverflow.com/a/56431189/1568890
has_arg() {
    local term="$1"
    shift
    for arg; do
        if [[ $arg == "$term" ]]; then
            return 0
        fi
    done
    return 1
}

if has_arg "--help" "$@" && ! has_arg "analysis" "$@" && ! has_arg "coverage" "$@" && ! has_arg "stack" "$@" && ! has_arg "experimental" "$@" && ! has_arg "agents" "$@" && ! has_arg "demo" "$@"; then
    # Notational conventions:
    #
    # - `[arg]`: Optional argument
    # - `<arg>`: Required argument
    # - `[...args]`: List of arguments
    echo "Command: dev

Usage:
    dev                      Starts developer environment
    dev check                Run source code checks for changed files
    dev check [...paths]     Run source code checks for the provided files
    dev check --all          Run all source code checks
    dev format               Run ESLint with --fix and Prettier on changed files
    dev format [...paths]    Run ESLint with --fix and Prettier on the provided files
    dev format --all         Run ESLint with --fix and Prettier on all files
    dev test                 Run unit tests for changed files
    dev test [...paths]      Run unit tests for the provided files
    dev test --all           Run all unit tests
    dev coverage             Run all unit tests and generate aggregate coverage reports
    dev coverage <package>   Run unit tests and coverage for one Bazel package
    dev testlogs             Inspect failed tests
    dev testlogs [path]      Inspect failed tests from a \"bazel_testlogs.zip\" file
    dev whoami               Print the username used to create branches
    dev branch <name>        Creates a new branch following our naming convention
    dev stack <command>      Manage a stack of branches for code review
    dev path                 Print important paths in your development environment
    dev path [name]          Print a single path in your development environment
    dev deployed             Check if the head commit has been deployed
    dev deployed [commit]    Check if the provided commit has been deployed
    dev sourcemap            Resolve a production stack trace using sourcemaps
    dev adhoc                List ad-hoc scripts
    dev adhoc <command>      Create or run ad-hoc scripts
    dev agents <command>     Manage agents-related services
    dev experimental         Run experimental scripts
    dev demo <command>       Manage scalable demo videos
    dev --help               Print this message"
    exit 0
fi

case "$1" in
    check)
        if has_arg "--all" "${@:2}"; then
            ./admin/bin/bazel test //... --test_tag_filters=dev-check,-adhoc
        elif [ -z "$2" ]; then
            # - `git diff --name-only main`: Finds all the files which are different from
            #   the `main` branch.
            #
            # - `grep -E '\.tsx?$'`: Filter out non-TypeScript files.
            #
            # - `xargs find 2> /dev/null`: Filter out files that don't exist, by default
            #   `find` prints the file name if it exists. Ideally we'd look for the closest
            #   `BUILD` file that exists near the deleted file.
            #
            # - `xargs | sed "s/ / union /g"`: Put files on one line with the string
            #   " union " between each file.
            files="$(git diff --name-only main | grep -E '\.tsx?$' | xargs find 2> /dev/null | xargs | sed "s/ / union /g")"

            if [ -z "$files" ]; then
                echo "No changed files"
            else
                query_base="tests(//...)"
                query="attr(tags, '\bdev-check\b', $query_base)"
                query="$query except attr(tags, '\badhoc\b', $query_base)"
                query="tests(rdeps($query, $files))"

                ./admin/bin/bazel query --noshow_progress "$query" | xargs ./admin/bin/bazel test
            fi
        else
            # - `echo "${@:2}"`: Use files from the command line.
            #
            # - `xargs | sed "s/ / union /g"`: Put files on one line with the string
            #   " union " between each file.
            files="$(echo "${@:2}" | xargs | sed "s/ / union /g")"

            if [ -z "$files" ]; then
                echo "No tests for sources"
            else
                query_base="tests(//...)"
                query="attr(tags, '\bdev-check\b', $query_base)"
                query="$query except attr(tags, '\badhoc\b', $query_base)"
                query="tests(rdeps($query, $files))"

                ./admin/bin/bazel query --noshow_progress "$query" | xargs ./admin/bin/bazel test
            fi
        fi
        ;;

    format)
        # Run format on specified files
        format_files="${@:2}"
        file_description="specified files"

        # Determine which files to format
        if has_arg "--all" "${@:2}"; then
            # Run format on all tracked files.
            format_files=$(git ls-files | grep -E '\.(tsx?|[cm]ts|jsx?|[cm]?js|css|json|md)$' | tr '\n' ' ')
            file_description="all files"
        elif [ -z "$2" ]; then
            # Run format on changed files
            format_files=$(git diff --name-only main | grep -E '\.(tsx?|[cm]ts|jsx?|[cm]?js|css|json|md)$' | xargs find 2> /dev/null | tr '\n' ' ')
            file_description="changed files"
        fi

        if [ -z "$format_files" ]; then
            echo "No $file_description to format"
        else
            echo -e "Formatting $file_description:\n"
            echo "$format_files" | tr ' ' '\n'
            echo

            # First run ESLint --fix on TypeScript/JavaScript files
            js_files=$(echo "$format_files" | tr ' ' '\n' | grep -E '\.(tsx?|[cm]ts|jsx?|[cm]?js)$' | tr '\n' ' ')
            if [ -n "$js_files" ]; then
                echo "Running ESLint --fix..."
                ./admin/bin/node admin/eslint/eslint_test.cjs --fix $js_files
                echo
            fi

            # Then run Prettier on all files
            echo "Running Prettier..."

            # TODO: Technically this won't work unless the developer has run pnpm install.
            # Ideally we'd implement this script hermetically with Bazel. Which would
            # involve setting up an sh_binary() or js_binary(), wiring in all the
            # dependencies, etc. then calling bazel run on that binary.
            ./admin/bin/pnpm exec prettier --write $format_files
        fi
        ;;

    test)
        # Check if LibreOffice is installed by checking the same paths as
        # `libreofficeExecutablePath` in `upload_file.ts`. If it's installed then we
        # can run LibreOffice tests.
        if [[ "$OSTYPE" == "darwin"* ]]; then
            if [ -z "/Applications/LibreOffice.app/Contents/MacOS/soffice" ]; then
                has_libreoffice=false
            else
                has_libreoffice=true
            fi
        elif [[ "$OSTYPE" == "linux"* ]]; then
            if [ -z "/usr/bin/libreoffice" ] && [ -z "/usr/bin/soffice" ] && [ -z "/snap/bin/libreoffice" ] && [ -z "/opt/libreoffice/program/soffice" ]; then
                has_libreoffice=false
            else
                has_libreoffice=true
            fi
        else
            has_libreoffice=false
        fi

        if has_arg "--all" "${@:2}"; then
            test_tag_filters=dev-test,-adhoc
            if [[ "$has_libreoffice" == "false" ]]; then
                test_tag_filters="$test_tag_filters,-libreoffice"
            fi

            ./admin/bin/bazel test //... "--test_tag_filters=$test_tag_filters"
        elif [ -z "$2" ]; then
            # - `git diff --name-only main`: Finds all the files which are different from
            #   the `main` branch.
            #
            # - `grep -E '\.tsx?$'`: Filter out non-TypeScript files.
            #
            # - `xargs find 2> /dev/null`: Filter out files that don't exist, by default
            #   `find` prints the file name if it exists. Ideally we'd look for the closest
            #   `BUILD` file that exists near the deleted file.
            #
            # - `xargs | sed "s/ / union /g"`: Put files on one line with the string
            #   " union " between each file.
            files="$(git diff --name-only main | grep -E '\.tsx?$' | xargs find 2> /dev/null | xargs | sed "s/ / union /g")"

            if [ -z "$files" ]; then
                echo "No changed files"
            else
                query_base="tests(//...)"
                query="attr(tags, '\bdev-test\b', $query_base)"
                query="$query except attr(tags, '\badhoc\b', $query_base)"
                if [[ "$has_libreoffice" == "false" ]]; then
                    query="$query except attr(tags, '\blibreoffice\b', $query_base)"
                fi
                query="tests(rdeps($query, $files))"

                ./admin/bin/bazel query --noshow_progress "$query" | xargs ./admin/bin/bazel test
            fi
        else
            # - `echo "${@:2}"`: Use files from the command line.
            #
            # - `xargs | sed "s/ / union /g"`: Put files on one line with the string
            #   " union " between each file.
            files="$(echo "${@:2}" | xargs | sed "s/ / union /g")"

            if [ -z "$files" ]; then
                echo "No tests for sources"
            else
                query_base="tests(//...)"
                query="attr(tags, '\bdev-test\b', $query_base)"
                query="$query except attr(tags, '\badhoc\b', $query_base)"
                if [[ "$has_libreoffice" == "false" ]]; then
                    query="$query except attr(tags, '\blibreoffice\b', $query_base)"
                fi
                query="tests(rdeps($query, $files))"

                tests="$(./admin/bin/bazel query --noshow_progress "$query")"
                if [ "$(wc -l <<< "$tests" | tr -d " ")" = "1" ]; then
                    echo -n $tests | xargs ./admin/bin/bazel test --test_output=streamed
                else
                    echo -n $tests | xargs ./admin/bin/bazel test
                fi
            fi
        fi
        ;;

    coverage)
        exec ./admin/bin/node admin/analysis/dev_coverage_main.cjs "${@:2}"
        ;;

    testlogs)
        # Base64 encode argument to support arguments with spaces in them (e.g.
        # downloads from a web browser like `bazel_testlogs (3).zip`).
        # `bazel run` doesn't work well with paths that contain spaces.
        ./admin/bin/bazel run --ui_event_filters=-info //admin/dev:testlogs -- "$(echo -n "$2" | base64)"
        ;;

    whoami)
        git credential fill <<EOF | grep username | cut -d= -f2
protocol=https
host=github.com
EOF
        ;;

    branch)
        username=$(git credential fill <<EOF | grep username | cut -d= -f2
protocol=https
host=github.com
EOF
)

        if [ -z "$2" ]; then
            echo "Missing branch name"
            echo
            echo "Usage: dev branch <name>"
            exit 1
        fi

        if [[ ! "$2" =~ ^[a-zA-Z][a-zA-Z0-9-]+$ ]]; then
            echo "Invalid branch name, must only use alphanumeric characters and \"-\""
            echo
            echo "Usage: dev branch <name>"
            exit 1
        fi

        # We recommend creating branches in the format
        # `${githubUsername}/${date}-${name}` because:
        #
        # 1. It makes it really easy to know who owns a branch
        #
        # 2. Branches have a natural lexicographic sorting, new branches are near the
        #    bottom and old branches are near the top
        #
        # 3. In some git UIs (like [Tower](https://www.git-tower.com/mac)) branches
        #    that start with a slash are put into a collapsible folder.
        git checkout -b "$username/$(date +%Y-%m-%d)-$2"
        ;;

    stack)
        ./admin/bin/bazel run --ui_event_filters=-info //admin/dev:stack -- ${@:2}
        ;;

    path)
        ./admin/bin/bazel run --ui_event_filters=-info //admin/dev:path -- ${@:2}
        ;;

    # Alias for `dev path` in case you typo.
    paths)
        ./admin/bin/bazel run --ui_event_filters=-info //admin/dev:path -- ${@:2}
        ;;

    deployed)
        ./admin/bin/bazel run --ui_event_filters=-info //admin/dev:deployed -- ${@:2}
        ;;

    sourcemap)
        ./admin/bin/bazel run --ui_event_filters=-info //admin/dev:sourcemap -- ${@:2}
        ;;

    adhoc)
        if [ -z "$2" ]; then
            ./admin/bin/bazel run --ui_event_filters=-info //admin/adhoc -- list
        else
            ./admin/bin/bazel run --ui_event_filters=-info //admin/adhoc -- "${@:2}"
        fi
        ;;

    agents)
        ./admin/bin/bazel run --ui_event_filters=-info //admin/dev:agents -- "${@:2}"
        ;;

    # This is temporary, once we're done with our demo comment format we'll delete this command
    demo)
        case "$2" in
            studio)
                exec ./admin/marketing/2026_04_scalable_demos/remotion_studio.sh
                ;;
            update-public)
                exec ./admin/bin/bazel build //admin/marketing/2026_04_scalable_demos:public
                ;;
            content-prompt)
                exec ./admin/bin/bazel run //admin/marketing/2026_04_scalable_demos:content_prompt -- "${@:3}"
                ;;
            new)
                ./admin/bin/bazel run --ui_event_filters=-info //admin/marketing/2026_04_scalable_demos:new_demo -- "${@:3}"
                ;;
            run)
                demo_arg="$3"
                if [ -z "$demo_arg" ]; then
                    echo "Usage: dev demo run <number-or-name>"
                    echo "  e.g. dev demo run 5"
                    echo "       dev demo run 005"
                    echo "       dev demo run 005_export_table_to_markdown"
                    exit 1
                fi

                demos_dir="./admin/marketing/2026_04_scalable_demos/demos"

                # Accept bare number (`5`, `005`) or full/partial name prefix
                # (`005_export_table_to_markdown`). Zero-pad numeric inputs and
                # glob the demos directory for the matching recorder file.
                if [[ "$demo_arg" =~ ^[0-9]+$ ]]; then
                    padded=$(printf "%03d" "$((10#$demo_arg))")
                    matches=($demos_dir/${padded}_*_demo_recorder.ts)
                else
                    matches=($demos_dir/${demo_arg}*_demo_recorder.ts)
                fi

                if [ ! -f "${matches[0]}" ]; then
                    echo "No demo recorder found matching: $demo_arg" >&2
                    exit 1
                fi

                if [ ${#matches[@]} -gt 1 ]; then
                    echo "Multiple demos matched \"$demo_arg\":" >&2
                    for m in "${matches[@]}"; do
                        echo "  $m" >&2
                    done
                    exit 1
                fi

                label=$(basename "${matches[0]}" .ts)
                exec ./admin/bin/bazel run //admin/marketing/2026_04_scalable_demos:${label}
                ;;
            *)
                echo "Usage: dev demo <studio|update-public|content-prompt|new|run>"
                exit 1
                ;;
        esac
        ;;

    experimental)
        ./admin/experimental/experimental.sh "${@:2}"
        ;;


    *)
        ./admin/bin/bazel run --ui_event_filters=-info //admin/dev
        ;;
esac

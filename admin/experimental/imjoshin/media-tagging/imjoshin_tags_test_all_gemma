#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

function print_usage {
    cat <<'EOF'
Usage:
  ./admin/experimental/imjoshin/media-tagging/imjoshin_tags_test_all_gemma [extra probe args...]

Runs the Bedrock Gemma media tagging probe on every non-JSON file in:
  admin/experimental/imjoshin/media-tagging/test-files/

For each input file, writes:
  <base-name>.gemma.json

next to the source file, overwriting any existing output file.
EOF
}

if [ "${1:-}" = "--help" ]; then
    print_usage
    exit 0
fi

script_directory="$(
    cd "$(dirname "${BASH_SOURCE[0]}")"
    pwd -P
)"
repository_root_directory="$(
    cd "$script_directory/../../../.."
    pwd -P
)"
test_files_directory_path="$script_directory/test-files"

if [ ! -d "$test_files_directory_path" ]; then
    printf 'Missing test-files directory: %s\n' "$test_files_directory_path" >&2
    exit 1
fi

cd "$repository_root_directory"

export TOKENIZERS_PARALLELISM=false

exec bazel run //admin/experimental/imjoshin/media-tagging:gemma_bedrock_probe -- \
    --directory="$test_files_directory_path" \
    --outputSuffix=".gemma.json" \
    "$@"

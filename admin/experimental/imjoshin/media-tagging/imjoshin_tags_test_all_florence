#!/usr/bin/env bash

set -o errexit -o nounset -o pipefail

function print_usage {
    cat <<'EOF'
Usage:
  ./admin/experimental/imjoshin/media-tagging/imjoshin_tags_test_all_florence [extra probe args...]

Runs the Florence-based media tagging probe on every non-JSON file in:
  admin/experimental/imjoshin/media-tagging/test-files/

For each input file, writes:
  <base-name>.florence.json

next to the source file, overwriting any existing output file.
EOF
}

if [ "${1:-}" = "--help" ]; then
    print_usage
    exit 0
fi

script_directory="$(
    cd "$(dirname "${BASH_SOURCE[0]}")"
    pwd -P
)"
python_venv_directory_path="${HOME}/.cache/cyberworlds/media-tagging-venv"
repository_root_directory="$(
    cd "$script_directory/../../../.."
    pwd -P
)"
test_files_directory_path="$script_directory/test-files"

if [ ! -d "$test_files_directory_path" ]; then
    printf 'Missing test-files directory: %s\n' "$test_files_directory_path" >&2
    exit 1
fi

cd "$repository_root_directory"

bazel build //admin/experimental/imjoshin/media-tagging:file_content_probe >/dev/null

bazel_bin_directory_path="$(bazel info bazel-bin)"
ffmpeg_directory_path="$bazel_bin_directory_path/admin/experimental/imjoshin/media-tagging/file_content_probe.sh.runfiles/ffmpeg/install/bin"

export TOKENIZERS_PARALLELISM=false

exec "$python_venv_directory_path/bin/python" "$script_directory/imjoshin_tags_florence_media_probe.py" \
    --directory="$test_files_directory_path" \
    --output-suffix=".florence.json" \
    --ffmpeg="$ffmpeg_directory_path/ffmpeg" \
    --ffprobe="$ffmpeg_directory_path/ffprobe" \
    "$@"

+  // NOTE(calebmer): Use the same encoding logic as strong/emphasis. We copied the
+  // surrounding code from `mdast-util-to-markdown/lib/handle/strong.js`.
+  let between = tracker.move(
+    state.containerPhrasing(node, {
+      ...tracker.current(),

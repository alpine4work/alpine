 }
+
+function getFirstCodePoint(string) {
+  if (string.length === 0) return ''
+  
+  const first = string.charCodeAt(0)
+  
+  // Check if it's a high surrogate
+  if (first >= 0xD800 && first <= 0xDBFF && string.length > 1) {
+    // Return 2 characters if it's a surrogate pair
+    return string.slice(0, 2)
+  }
+  
+  // Return single character
+  return string.slice(0, 1)
+}
+
+function getLastCodePoint(string) {
+  if (string.length === 0) return ''
+  
+  const lastChar = string.charCodeAt(string.length - 1)
+  
+  // Check if it's a low surrogate (0xDC00-0xDFFF)
+  if (lastChar >= 0xDC00 && lastChar <= 0xDFFF && string.length > 1) {
+    // It's a low surrogate, so the code point starts at length - 2
+    return string.slice(-2)
+  }
+  
+  // It's either a BMP character or a high surrogate without a pair
+  return string.slice(-1)
+}

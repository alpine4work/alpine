diff --git a/cjs/react-dom-client.development.js b/cjs/react-dom-client.development.js
index d005d8b99c428f58cdf62f50027fb855443f98ba..a86157b60c876a17c3e52d1d59dd0a3870db879b 100644
--- a/cjs/react-dom-client.development.js
+++ b/cjs/react-dom-client.development.js
@@ -13249,7 +13249,9 @@
               (lastEffect = runWithFiberInDEV(
                 finishedWork,
                 callCreateInDEV,
-                updateQueue
+                updateQueue,
+                flags,
+                finishedWork
               )),
               (flags & Insertion) !== NoFlags &&
                 (isRunningInsertionEffect = !1),
@@ -25983,10 +25985,48 @@
           callComponentWillUnmount
         ),
       callCreate = {
-        react_stack_bottom_frame: function (effect) {
+        react_stack_bottom_frame: function (effect, flags, finishedWork) {
           var create = effect.create;
           effect = effect.inst;
-          create = create();
+          // NOTE(calebmer): We want access to our component's DOM during
+          // insertion effects. React doesn't provide a way in the public API for
+          // us to do this.
+          //
+          // - `ref`s aren't initialized until the layout effect phase
+          // - Element's are "headless" and not added to `document` until the
+          //   insertion phase finishes so we can't call
+          //   `document.getElementById()`
+          //
+          // We want the ability to manually mutate the DOM ourselves for
+          // integrating with third-party libraries like ProseMirror. If we mutate
+          // the DOM in a layout effect we get [layout thrashing][1] on UIs which
+          // render many ProseMirror editors. Like a task grid view.
+          //
+          // The sequence happens like this:
+          //
+          // 1. Task 1 has ProseMirror add its editor to the DOM in a layout effect
+          // 2. Task 1 has some other component that reads from the DOM in a
+          //    layout effect or ref (e.g. `useLifecycleRef()`, refs run during
+          //    the React layout phase). This could be a `<Tooltip>` or
+          //    `<VirtualizedScrollView>` or anything really. It's by design that
+          //    you can read from the DOM in a layout effect or ref. Anyway, this
+          //    read forces a browser layout.
+          // 3. Task 2 has ProseMirror add its editor to the DOM in a layout effect
+          // 4. Task 2 has some other component that reads from the DOM which
+          //    forces another browser layout.
+          // 5. So on for all remaining tasks...
+          //
+          // Given layout thrashing is expensive we want to batch our mutations
+          // with React's DOM mutations then only let layout effects read from the
+          // DOM (and avoid mutating the DOM). But that means we need access to
+          // the DOM from an insertion effect which is why we have this patch.
+          //
+          // [1]: https://gist.github.com/paulirish/5d52fb081b3570c81e3a
+          if ((flags & Insertion) !== NoFlags) {
+            create = create(finishedWork.child !== null && finishedWork.child.sibling === null ? finishedWork.child.stateNode : null);
+          } else {
+            create = create();
+          }
           return (effect.destroy = create);
         }
       },

diff --git a/foreign_cc/private/framework.bzl b/foreign_cc/private/framework.bzl
index 892467e..b4138db 100644
--- a/foreign_cc/private/framework.bzl
+++ b/foreign_cc/private/framework.bzl
@@ -460,6 +460,44 @@ def cc_external_rule_impl(ctx, attrs):
     ] + _print_env() + _copy_deps_and_tools(inputs) + [
         "cd $$BUILD_TMPDIR$$",
     ] + attrs.create_configure_script(ConfigureParameters(ctx = ctx, attrs = attrs, inputs = inputs)) + postfix_script + [
+        # NOTE(calebmer): Looks like by default MacOS dynamic libraries are built with
+        # an absolute path for `LC_ID_DYLIB` unless `-install_name` is set. The problem
+        # is the absolute path at build time will be in a Bazel sandbox directory! If a
+        # program is dynamically linked to this shared library, it will try to load the
+        # library from `LC_ID_DYLIB` which fails because the original build directory
+        # is gone.
+        #
+        # So on MacOS we use `install_name_tool {file} -id {id}` at the end of the
+        # build to change `LC_ID_DYLIB` to a relative path based on `@loader_path`. We
+        # make some assumptions about the build directory layout created by
+        # `rules_foreign_cc`. Namely that libraries live under the path
+        # `external/{workspace_name}/{target_name}/lib/{lib_name}`. Which means we can
+        # set `LC_ID_DYLIB` to
+        # `@loader_path/../../../{workspace_name}/{target_name}/lib/{lib_name}` and
+        # it'll point to the right location.
+        #
+        # Since this runs at the end of the build, the build tool may have built some
+        # of its dynamic libraries and binaries with links to other libraries generated
+        # by the same build. When the build tool performs this link `LC_ID_DYLIB` will
+        # be the sandbox absolute path. So this script also runs
+        # `install_name_tool {file} -change {old} {new}` for every other shared library
+        # to make sure any `LC_LOAD_DYLIB` references to other shared libraries from
+        # this build are replaced with relative paths.
+        #
+        # The `{old}` paths we change are:
+        #
+        # 1. Paths to dynamic libraries in the same directory as our file
+        #    (installation path).
+        # 2. Paths to dynamic libraries in the `build_tmpdir` for our build.
+        #
+        # This script line noops for all other platforms.
+        "##macos_install_name_tool_lib## {}".format(file.path)
+        for file in outputs.libraries.shared_libraries
+    ] + [
+        # Make sure `LC_LOAD_DYLIB` references in built binaries are updated too.
+        "##macos_install_name_tool_bin## {}".format(file.path)
+        for file in outputs.out_binary_files
+    ] + [
         # replace references to the root directory when building ($BUILD_TMPDIR)
         # and the root where the dependencies were installed ($EXT_BUILD_DEPS)
         # for the results which are in $INSTALLDIR (with placeholder)

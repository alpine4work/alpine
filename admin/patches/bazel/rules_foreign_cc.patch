diff --git a/foreign_cc/private/framework/toolchains/macos_commands.bzl b/foreign_cc/private/framework/toolchains/macos_commands.bzl
index ed04f24..90ad807 100644
--- a/foreign_cc/private/framework/toolchains/macos_commands.bzl
+++ b/foreign_cc/private/framework/toolchains/macos_commands.bzl
@@ -266,6 +266,44 @@ if [[ -L "{file}" ]]; then
 fi
 """.format(file = file)
 
+def macos_install_name_tool_lib(file):
+    return """\
+install_name_tool_file="$EXT_BUILD_ROOT/{file}"
+install_name_tool_dirname1="$(dirname $install_name_tool_file)"
+install_name_tool_dirname2="$(dirname $install_name_tool_dirname1)"
+install_name_tool_dirname3="$(dirname $install_name_tool_dirname2)"
+install_name_tool_args="$install_name_tool_file -id @loader_path/../../../$(basename "$install_name_tool_dirname3")/$(basename "$install_name_tool_dirname2")/$(basename "$install_name_tool_dirname1")/$(basename "$install_name_tool_file")"
+for install_name_tool_file in "$install_name_tool_dirname1"/*; do
+    if [[ -f "$install_name_tool_file" ]]; then
+        install_name_tool_dirname1="$(dirname $install_name_tool_file)"
+        install_name_tool_dirname2="$(dirname $install_name_tool_dirname1)"
+        install_name_tool_dirname3="$(dirname $install_name_tool_dirname2)"
+        install_name_tool_args="$install_name_tool_args -change $install_name_tool_file @loader_path/../../../$(basename "$install_name_tool_dirname3")/$(basename "$install_name_tool_dirname2")/$(basename "$install_name_tool_dirname1")/$(basename "$install_name_tool_file")"
+        install_name_tool_args="$install_name_tool_args -change $install_name_tool_dirname3/$(basename "$install_name_tool_dirname2").build_tmpdir/$(basename "$install_name_tool_dirname2")/$(basename "$install_name_tool_dirname1")/$(basename "$install_name_tool_file") @loader_path/../../../$(basename "$install_name_tool_dirname3")/$(basename "$install_name_tool_dirname2")/$(basename "$install_name_tool_dirname1")/$(basename "$install_name_tool_file")"
+    fi
+done
+install_name_tool $install_name_tool_args
+""".format(file = file)
+
+def macos_install_name_tool_bin(file):
+    return """\
+install_name_tool_bin_file="$EXT_BUILD_ROOT/{file}"
+install_name_tool_args=""
+for install_name_tool_file in "$(dirname $(dirname $install_name_tool_bin_file))"/lib/*; do
+    if [[ -f "$install_name_tool_file" ]]; then
+        install_name_tool_dirname1="$(dirname $install_name_tool_file)"
+        install_name_tool_dirname2="$(dirname $install_name_tool_dirname1)"
+        install_name_tool_dirname3="$(dirname $install_name_tool_dirname2)"
+        install_name_tool_args="$install_name_tool_args -change $install_name_tool_file @loader_path/../../../$(basename "$install_name_tool_dirname3")/$(basename "$install_name_tool_dirname2")/$(basename "$install_name_tool_dirname1")/$(basename "$install_name_tool_file")"
+        install_name_tool_args="$install_name_tool_args -change $install_name_tool_dirname3/$(basename "$install_name_tool_dirname2").build_tmpdir/$(basename "$install_name_tool_dirname2")/$(basename "$install_name_tool_dirname1")/$(basename "$install_name_tool_file") @loader_path/../../../$(basename "$install_name_tool_dirname3")/$(basename "$install_name_tool_dirname2")/$(basename "$install_name_tool_dirname1")/$(basename "$install_name_tool_file")"
+    fi
+done
+if [ ! -z "$install_name_tool_args" ]; then
+  # Ignore error in case `install_name_tool_bin_file` is not a Mach-O file.
+  install_name_tool "$install_name_tool_bin_file" $install_name_tool_args || true
+fi
+""".format(file = file)
+
 commands = struct(
     assert_script_errors = assert_script_errors,
     cat = cat,
@@ -291,6 +329,8 @@ commands = struct(
     replace_in_files = replace_in_files,
     replace_sandbox_paths = replace_sandbox_paths,
     replace_symlink = replace_symlink,
+    macos_install_name_tool_lib = macos_install_name_tool_lib,
+    macos_install_name_tool_bin = macos_install_name_tool_bin,
     rm_rf = rm_rf,
     script_extension = script_extension,
     script_prelude = script_prelude,

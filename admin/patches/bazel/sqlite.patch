diff --git a/src/sqlite.h.in b/src/sqlite.h.in
--- a/src/sqlite.h.in
+++ b/src/sqlite.h.in
@@ -7170,6 +7170,38 @@
 void *sqlite3_update_hook(
   sqlite3*,
   void(*)(void *,int ,char const *,char const *,sqlite3_int64),
+  void*
+);
+
+/*
+** CAPI3REF: Page Access Notification Callback
+** METHOD: sqlite3
+**
+** ^The sqlite3_page_access_hook() interface registers a callback
+** function with the [database connection] identified by the first
+** argument to be invoked whenever a database page is read or written
+** in the main database.
+**
+** ^The second argument is a pointer to the callback function. The
+** callback receives three arguments: a copy of the third argument to
+** sqlite3_page_access_hook(), the page number, and a flags value.
+** The flags value is SQLITE_PAGE_READ (1) when a page is read and
+** SQLITE_PAGE_WRITE (2) when a page is first made writable in a
+** transaction.
+**
+** ^The page access hook is disabled by invoking
+** sqlite3_page_access_hook() with a NULL pointer as the second
+** parameter.
+**
+** ^sqlite3_page_access_hook(D,C,P) returns the P argument from
+** the previous call on the same [database connection] D, or NULL
+** for the first call on D.
+*/
+#define SQLITE_PAGE_READ  1
+#define SQLITE_PAGE_WRITE 2
+void *sqlite3_page_access_hook(
+  sqlite3*,
+  void(*)(void*, int, int),
   void*
 );
 

diff --git a/src/main.c b/src/main.c
--- a/src/main.c
+++ b/src/main.c
@@ -2368,6 +2368,30 @@
   pRet = db->pUpdateArg;
   db->xUpdateCallback = xCallback;
   db->pUpdateArg = pArg;
+  sqlite3_mutex_leave(db->mutex);
+  return pRet;
+}
+
+/*
+** Register a callback to be invoked each time a database page is
+** read or written.
+*/
+void *sqlite3_page_access_hook(
+  sqlite3 *db,
+  void (*xCallback)(void*, int, int),
+  void *pArg
+){
+  void *pRet;
+#ifdef SQLITE_ENABLE_API_ARMOR
+  if( !sqlite3SafetyCheckOk(db) ){
+    (void)SQLITE_MISUSE_BKPT;
+    return 0;
+  }
+#endif
+  sqlite3_mutex_enter(db->mutex);
+  pRet = sqlite3PagerSetPageAccessHook(
+    sqlite3BtreePager(db->aDb[0].pBt), xCallback, pArg
+  );
   sqlite3_mutex_leave(db->mutex);
   return pRet;
 }


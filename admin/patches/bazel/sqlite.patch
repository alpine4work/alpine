+/*
+** Register a callback to be invoked each time a database page is
+** read or written, on every database currently attached to the
+** connection (main, temp, and any ATTACH-ed schemas). The pArg
+** the callback receives is a `const char*` pointer to the firing
+** schema's name (db->aDb[i].zDbSName), which lives for the
+** lifetime of the connection. The `pArg` argument to this
+** function is unused — carried for ABI compatibility.
+**
+** Note: pagers created by ATTACH after this call do NOT inherit
+** the hook automatically; callers must re-invoke this function
+** after each ATTACH.
+*/
+void *sqlite3_page_access_hook(
+  sqlite3 *db,
+  void (*xCallback)(void*, int, int),
+  void *pArg
+){
+  void *pRet = 0;
+  int i;
+#ifdef SQLITE_ENABLE_API_ARMOR
+  if( !sqlite3SafetyCheckOk(db) ){
+    (void)SQLITE_MISUSE_BKPT;
+    return 0;
+  }
+#endif
+  (void)pArg;
+  sqlite3_mutex_enter(db->mutex);
+  for(i=0; i<db->nDb; i++){
+    if( db->aDb[i].pBt ){
+      pRet = sqlite3PagerSetPageAccessHook(
+        sqlite3BtreePager(db->aDb[i].pBt), xCallback,
+        (void*)db->aDb[i].zDbSName
+      );
+    }
+  }
+  sqlite3_mutex_leave(db->mutex);
+  return pRet;
+}

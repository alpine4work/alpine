diff --git a/swc/private/swc_wrapper.sh b/swc/private/swc_wrapper.sh
new file mode 100755
index 0000000..83077f2
--- /dev/null
+++ b/swc/private/swc_wrapper.sh
@@ -0,0 +1,114 @@
+#!/bin/bash
+
+# HACK(calebmer): In SWC v1.3.36 symlink handling for our Bazel usecase with
+# `paths` broke. We think because of [this commit][1]. After this commit, SWC
+# resolves the source file's real path (which will be in the source directory
+# instead of Bazel output directory) and updates any import paths to be relative
+# to that. This is bad since the SWC config is in the Bazel build directory so
+# we end up with imports that look like this:
+#
+# ```
+# import { ChatMessageModel } from "../../../../../private/var/tmp/_bazel_calebmer/a7dcf50ffe77e6533f25aef732fa0d3d/sandbox/darwin-sandbox/19/execroot/cyberworlds/bazel-out/darwin_arm64-fastbuild/shared/chat/chat_model.js";
+# import { createMessagingRealtimeEventSchemas, createMessagingRealtimeProcedureSchemas } from "../../../../../private/var/tmp/_bazel_calebmer/a7dcf50ffe77e6533f25aef732fa0d3d/sandbox/darwin-sandbox/19/execroot/cyberworlds/bazel-out/darwin_arm64-fastbuild/shared/messaging/messaging_realtime_protocol.js";
+# import { defineWebSocketProtocol } from "../../../../../private/var/tmp/_bazel_calebmer/a7dcf50ffe77e6533f25aef732fa0d3d/sandbox/darwin-sandbox/19/execroot/cyberworlds/bazel-out/darwin_arm64-fastbuild/shared/web_socket/web_socket_protocol.js";
+# export const ChatRealtimeProtocol = defineWebSocketProtocol({
+#     procedures: createMessagingRealtimeProcedureSchemas(ChatMessageModel.schema()),
+#     events: createMessagingRealtimeEventSchemas(ChatMessageModel.schema())
+# });
+# ```
+#
+# Instead of imports that look like this:
+#
+# ```
+# import { ChatMessageModel } from "./chat_model.js";
+# import { createMessagingRealtimeEventSchemas, createMessagingRealtimeProcedureSchemas } from "../messaging/messaging_realtime_protocol.js";
+# import { defineWebSocketProtocol } from "../web_socket/web_socket_protocol.js";
+# export const ChatRealtimeProtocol = defineWebSocketProtocol({
+#     procedures: createMessagingRealtimeProcedureSchemas(ChatMessageModel.schema()),
+#     events: createMessagingRealtimeEventSchemas(ChatMessageModel.schema())
+# });
+# ```
+#
+# This wrapper script creates a copy of the SWC config file that sets `baseUrl`
+# to an absolute path in the source directory which allows SWC to make import
+# paths relative to the right directory.
+#
+# [1]: https://github.com/swc-project/swc/commit/1ec161a0f15886f97d4fb9cbb5d115b29ed5e2a2
+
+set -e
+
+args=("$@")
+config_file=""
+config_file_index=-1
+source_file=""
+i=0
+
+# Parse arguments
+for (( i=0; i<${#args[@]}; i++ )); do
+    arg="${args[$i]}"
+    
+    if [[ "$arg" == "--config-file" ]]; then
+        ((i++))
+        config_file="${args[$i]}"
+        config_file_index=$i
+    elif [[ "$arg" == --* ]]; then
+        # Other option with value, skip the value
+        ((i++))
+    else
+        # Standalone argument
+        source_file="$arg"
+    fi
+done
+
+if [[ -z "$source_file" ]]; then
+    echo "Error: No TypeScript source file found" >&2
+    exit 1
+fi
+
+if [[ -z "$config_file" ]]; then
+    # If there are plugins, `rules_swc` runs SWC once with `--config-json` and a
+    # `/dev/null` input. We don't need to update the config file in this case (there
+    # is no config file).
+    # https://github.com/cyberworlds/rules_swc/blob/65c3bc36a221157c6001a63ffc06579625004b34/swc/private/swc.bzl#L328-L355
+    if [[ "$source_file" == "/dev/null" ]]; then
+        exec "$SWC_BINARY" "${args[@]}"
+    fi
+    echo "Error: No config file found" >&2
+    exit 1
+fi
+
+# Normalize source file path (remove leading ./)
+source_file="${source_file#./}"
+
+# Get absolute path of source file
+absolute_source_path=$(readlink -f "$source_file")
+
+# Calculate base path by removing the relative path from the absolute path
+base_path="${absolute_source_path%"$source_file"}"
+
+# Remove trailing slash if present
+base_path="${base_path%/}"
+
+# Get the directory of the config file
+config_dir=$(dirname "$config_file")
+
+# Create output config file path
+output_config="$config_dir/actual_typescript_swc_config.json"
+
+# Copy and modify config file using awk (more portable than sed -i)
+awk -v bp="$base_path" '{
+    gsub(/"baseUrl": "/, "\"baseUrl\": \"" bp "/")
+    print
+}' "$config_file" > "$output_config"
+
+# Rebuild args with the new config file path
+new_args=()
+for (( i=0; i<${#args[@]}; i++ )); do
+    if [[ $i -eq $config_file_index ]]; then
+        new_args+=("$output_config")
+    else
+        new_args+=("${args[$i]}")
+    fi
+done
+
+exec "$SWC_BINARY" "${new_args[@]}"

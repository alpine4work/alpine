diff --color -bur a/config/jvm.options b/config/jvm.options
--- a/config/jvm.options	2024-03-25 13:59:25
+++ b/config/jvm.options	2024-08-07 14:06:58
@@ -60,21 +60,14 @@
 # has sufficient space
 -XX:HeapDumpPath=data
 
-# specify an alternative path for JVM fatal error logs
--XX:ErrorFile=logs/hs_err_pid%p.log
-
-## JDK 8 GC logging
-8:-XX:+PrintGCDetails
-8:-XX:+PrintGCDateStamps
-8:-XX:+PrintTenuringDistribution
-8:-XX:+PrintGCApplicationStoppedTime
-8:-Xloggc:logs/gc.log
-8:-XX:+UseGCLogFileRotation
-8:-XX:NumberOfGCLogFiles=32
-8:-XX:GCLogFileSize=64m
-
-# JDK 9+ GC logging
-9-:-Xlog:gc*,gc+age=trace,safepoint:file=logs/gc.log:utctime,pid,tags:filecount=32,filesize=64m
+# NOTE(calebmer): Remove GC logging from local OpenSearch instance. GC logging
+# specifies a relative path which is a problem when running in a Linux sandbox
+# where most of the file system is read-only to the executing program. Trying
+# to write to this relative path was causing all tests that us OpenSearch to
+# fail on our Linux CI servers!
+#
+# If we want GC logging we can add it back in `startOpensearchLocal()` under
+# `logsPath` which is a writable directory.
 
 # Explicitly allow security manager (https://bugs.openjdk.java.net/browse/JDK-8270380)
 18-:-Djava.security.manager=allow
diff --color -bur a/config/opensearch.yml b/config/opensearch.yml
--- a/config/opensearch.yml	2024-03-25 13:59:25
+++ b/config/opensearch.yml	2024-08-07 14:06:00
@@ -14,7 +14,7 @@
 #
 # Use a descriptive name for your cluster:
 #
-#cluster.name: my-application
+cluster.name: cyberworlds_development
 #
 # ------------------------------------ Node ------------------------------------
 #
@@ -125,3 +125,27 @@
 # Gates the functionality of enabling Opensearch to use pluggable caches with respective store names via setting.
 #
 #opensearch.experimental.feature.pluggable.caching.enabled: false
+
+# NOTE(calebmer): We only run a single OpenSearch node locally.
+discovery.type: single-node
+
+# NOTE(calebmer): By default, OpenSearch won't let you create new indexes if
+# more than 85% ([source][1]) of your disk space is used. You'll get an
+# `index_create_block_exception` error with the reason:
+# `blocked by: [FORBIDDEN/10/cluster create-index blocked (api)];`.
+#
+# In development we run a single OpenSearch node on the developer's machine
+# where resources are shared with many other processes and applications. It's
+# unreasonable for OpenSearch to require 15% free storage space on the machine,
+# especially if the machine's available storage space is low. So raise the
+# storage watermark at which OpenSearch will stop creating indexes for local
+# development.
+#
+# Consider removing these raised watermarks when developers use company
+# provided laptops where we have more control over developer machine resource
+# usage.
+#
+# [1]: https://github.com/opensearch-project/OpenSearch/blob/91067134e8e0a6dbfb05317afe4752194a8a69d2/server/src/main/java/org/opensearch/cluster/routing/allocation/DiskThresholdSettings.java#L63-L70
+cluster.routing.allocation.disk.watermark.low: 97%
+cluster.routing.allocation.disk.watermark.high: 98%
+cluster.routing.allocation.disk.watermark.flood_stage: 99%

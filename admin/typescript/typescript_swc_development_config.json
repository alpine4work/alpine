{
    "$schema": "http://json.schemastore.org/swcrc",
    "env": {
        "targets": {
            "node": "18.9.1"
        }
    },
    "jsc": {
        "baseUrl": "./.null",
        "paths": {
            "~/*": ["../*"]
        },
        "parser": {
            "syntax": "typescript"
        },
        "transform": {
            "react": {
                "development": true
            }
        }
    },
    "module": {
        "type": "commonjs"
    }
}

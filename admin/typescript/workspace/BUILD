load("@aspect_bazel_lib//lib:write_source_files.bzl", "write_source_files")
load("@aspect_rules_js//js:defs.bzl", "js_binary")
load("//admin/typescript:typescript.bzl", "ts_lint_and_format_test")
load("//admin/typescript/workspace:workspace_typescript_test.bzl", "workspace_typescript_test")

workspace_typescript_test(
    name = "workspace_test",
    size = "medium",
    tags = [
        "eslint",
        "typescript",
    ],
)

ts_lint_and_format_test(
    name = "workspace",
)

js_binary(
    name = "workspace_test_bin",
    data = [
        "//:eslint_config_files",
        "//:node_modules/@typescript-eslint/eslint-plugin",
        "//:node_modules/eslint",
        "//:node_modules/typescript",
    ],
    entry_point = "workspace_typescript_test.cjs",
    env = {
        "NODE_ENV": "test",
        # Make sure `chalk` (used by ESLint) always renders colors. Bazel will strip
        # Ansi codes when appropriate.
        "FORCE_COLOR": "1",
    },
)

# Every `ts_project()` rule in our codebase is in the transitive dependency
# closure of these roots. Ideally we want to keep this list as short as
# possible and use `genquery()` to enumerate all other `ts_project()` rules.
#
# To see if we are indeed matching every `ts_project()` rule in our codebase
# you can run the following to get a diff:
#
# ```
# bazel build //admin/typescript/workspace:workspace_typescript_projects && diff -u bazel-bin/admin/typescript/workspace/workspace_typescript_projects <(bazel query 'kind(ts_project, //...)')
# ```
WORKSPACE_TYPESCRIPT_PROJECT_ROOTS = [
    "//.vscode/extensions/bazel_test_codelens:bazel_test_codelens",
    "//admin/adhoc",
    "//admin/aws:cdk",
    "//admin/dev",
    "//admin/dynamo",
    "//admin/eslint",
    "//app/integration_tests:integration_tests_lib",
    "//client/content/file_entity/internal/test_helpers",
    # Can't use `//native/mobile/ios:app` since then we need to traverse
    # `swift_library()` and `ios_application()` which we can't do on our Linux CI
    # server since Swift isn't installed.
    "//native/mobile/ios/Resources/Assets.xcassets",
    "//server/agents",
    "//server/api",
    "//server/api/specification:specification_generate_lib",
    "//server/deploy/script",
    "//server/edge",
    "//server/files/processor/test_helpers",
    "//server/messaging/realtime/test_helpers",
    "//server/notifications/data:notifications_actions_forum_test",
    "//server/tasks/realtime:task_realtime_connection_test",
    "//shared/spaces/test_helpers",
]

genquery(
    name = "workspace_typescript_projects",
    expression = " union ".join(["kind(ts_project, deps({}))".format(root) for root in WORKSPACE_TYPESCRIPT_PROJECT_ROOTS]),
    scope = WORKSPACE_TYPESCRIPT_PROJECT_ROOTS,
)

genrule(
    name = "workspace_typescript_projects_bzl",
    srcs = [":workspace_typescript_projects"],
    outs = [":workspace_typescript_projects_output.bzl"],
    cmd = """
echo "# @generated by //admin/typescript/workspace:write_workspace_typescript_projects" >> "$@"
echo >> "$@"
echo "\\"\\"\\"" >> "$@"
echo "Every \\`ts_project()\\` rule in our codebase." >> "$@"
echo "\\"\\"\\"" >> "$@"
echo >> "$@"
echo "WORKSPACE_TYPESCRIPT_PROJECTS = [" >> "$@"

while read line; do
   echo -e "    \\"$$line\\"," >> "$@"
done < $(location :workspace_typescript_projects)

echo "]" >> "$@"
""",
)

write_source_files(
    name = "write_workspace_typescript_projects",
    files = {
        "workspace_typescript_projects.bzl": "//admin/typescript/workspace:workspace_typescript_projects_output.bzl",
    },
)

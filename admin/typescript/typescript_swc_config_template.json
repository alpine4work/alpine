{
    "$schema": "http://json.schemastore.org/swcrc",
    "env": {
        "targets": {
            "node": "22.23.2"
        }
    },
    "jsc": {
        "baseUrl": "admin/typescript/base",
        "paths": {
            "~/*": ["../../../*"],
            "~/external/*": ["../../../external/*"]
        },
        "parser": {
            "syntax": "typescript"
        },
        "transform": {
            "{{react}}": {}
        },
        "experimental": {
            "keepImportAttributes": true
        }
    },
    "module": {
        "type": "{{module_type}}"
    }
}

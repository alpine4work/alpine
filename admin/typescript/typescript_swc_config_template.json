{
    "$schema": "http://json.schemastore.org/swcrc",
    "env": {
        "targets": {
            "node": "22.11.0"
        }
    },
    "jsc": {
        "baseUrl": "admin/typescript/base",
        "paths": {
            "~/*": ["../../../*"]
        },
        "parser": {
            "syntax": "typescript"
        },
        "transform": {
            "{{react}}": {}
        }
    },
    "module": {
        "type": "{{module_type}}"
    }
}

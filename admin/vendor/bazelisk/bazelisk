#!/bin/sh

workspace_path=$(cd $(dirname $0)/../../.. && pwd)

platform_name="$(uname -s | tr '[:upper:]' '[:lower:]')"

arch_name="$(uname -m)"
if [ "$arch_name" = "amd64" ]; then
    arch_name="x86_64"
fi
if [ "$arch_name" = "aarch64" ]; then
    arch_name="arm64"
fi

"$workspace_path/admin/vendor/bazelisk/bazelisk-$platform_name-$arch_name" "$@"

load("@aspect_rules_js//js:providers.bzl", "JsInfo")

AppClientNodeModulesInfo = provider(
    doc = "The direct node module dependencies of this target",
    fields = {
        "transitive_node_modules": "A depset of node module names we directly depend on (excludes the transitive dependencies of the node modules)",
        "transitive_client_node_modules": "`transitive_node_modules` but only those depended on by client packages",
    },
)

def _app_client_node_modules_aspect_impl(target, ctx):
    if not (JsInfo in target):
        return []

    transitive_node_modules = []
    transitive_client_node_modules = []

    # Only collect dependencies for `js_library()` rules. This excludes
    # dependencies of build tools (e.g. esbuild) that output a `JsInfo` but whose
    # `deps` are build dependencies not runtime dependencies.
    if ctx.rule.kind == "js_library":
        if hasattr(ctx.rule.attr, "deps"):
            for dep in ctx.rule.attr.deps:
                if AppClientNodeModulesInfo in dep:
                    transitive_node_modules.append(dep[AppClientNodeModulesInfo].transitive_node_modules)
                    transitive_client_node_modules.append(dep[AppClientNodeModulesInfo].transitive_client_node_modules)

    our_node_modules = [target.label.name[13:]] if (
        target.label.repo_name == "" and
        target.label.package == "" and
        target.label.name.startswith("node_modules/")
    ) else []

    transitive_node_modules = depset(
        our_node_modules,
        transitive = transitive_node_modules,
    )

    return [AppClientNodeModulesInfo(
        transitive_node_modules = transitive_node_modules,

        # If this is a client package, include ALL transitive node module dependencies.
        # Otherwise, only include accumulated client dependencies.
        transitive_client_node_modules = transitive_node_modules if (
            target.label.repo_name == "" and
            target.label.package.startswith("client/")
        ) else depset(
            transitive = transitive_client_node_modules,
        ),
    )]

app_client_node_modules_aspect = aspect(
    _app_client_node_modules_aspect_impl,
    attr_aspects = ["deps"],
)

def _app_client_node_modules_impl(ctx):
    node_modules = sorted(ctx.attr.target[AppClientNodeModulesInfo].transitive_client_node_modules.to_list())

    node_modules_json = "[\n{}\n]\n".format(",\n".join(["    \"{}\"".format(node_module) for node_module in node_modules]))

    output = ctx.actions.declare_file("{}.json".format(ctx.label.name))
    ctx.actions.write(output, node_modules_json)

    return [DefaultInfo(files = depset([output]))]

app_client_node_modules = rule(
    _app_client_node_modules_impl,
    attrs = {
        "target": attr.label(providers = [JsInfo], aspects = [app_client_node_modules_aspect]),
    },
)

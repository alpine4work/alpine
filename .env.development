# We spawn local servers in our dev environment. We shouldn't connect to AWS.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_BEDROCK_TOKEN=

# Suffix to use for the name of our development environment OS paths. e.g. Our
# data path, cache path, temporary path, etc. Also used as the suffix for HTTP
# cookie names since cookies are shared across all localhost ports.
DEV_ENV_PATHS_NAME_SUFFIX=

# If you're working on the Cursor agent and want to debug cloud agent webhooks:
#
# 1. Visit https://smee.io, press "Start a new channel"
#
# 2. Copy the proxy URL it gives you into `.env.development.local` as
#    `CURSOR_AGENT_SMEE_WEBHOOK_URL`
#
# 3. Restart `dev` so it picks up the new env variable
#
# 4. Run `smee-client` (installed via `pnpm install --global smee-client`) with
#    the URL logged by the Cursor agent durable object when you launch a cloud
#    agent as the `--target` option. (You have to do this quickly!)
#
# Example, add this to `.env.development.local` (but with your real smee URL):
#
# ```
# CURSOR_AGENT_SMEE_WEBHOOK_URL=https://smee.io/xxxxxxxxxxxxxxxx
# ```

# Optional shared secrets for signing Alpine bot webhook deliveries in dev.
# When set, `dev` seeds the matching bot record with the same secret and passes
# it to the agent service durable object.
#
# CHAT_GPT_WEBHOOK_SECRET=
# CLAUDE_WEBHOOK_SECRET=
# CURSOR_WEBHOOK_SECRET=
# MOCK_CHAT_GPT_WEBHOOK_SECRET=
# MOCK_CURSOR_WEBHOOK_SECRET=

# Port strategy:
#
# - Each kind of service should have 10 reserved ports
# - Services we develop and deploy to production live between 3000-3499
# - Third-party and dev environment services live between 3500-3999

# `EdgeServiceFamily`: 3000-3009
EDGE_DEV_PORT=3000
EDGE_DEV_INSPECTOR_PORT=3001

# `AppService`: 3010-3019
APP_DEV_PORT=3010
APP_DEV_INSPECTOR_PORT=3011

# `TaskRealtimeService`: 3020-3029
TASK_REALTIME_DEV_PORT=3020
TASK_REALTIME_DEV_INSPECTOR_PORT=3021

# `JobQueueService`: 3030-3039
JOB_QUEUE_DEV_INSPECTOR_PORT=3031

# While not part of `JobQueueService`, we reserve port 3039 for the test
# debugger inspector port since `JobQueueService` isn't using its full port
# range.
TEST_DEBUGGER_INSPECTOR_PORT=3039

# `FileProcessorService`: 3040-3049
FILE_PROCESSOR_DEV_PORT=3040
FILE_PROCESSOR_DEV_INSPECTOR_PORT=3041

# `ApiService`: 3050-3059
API_DEV_PORT=3050
API_DEV_INSPECTOR_PORT=3051

# `AgentService`: 3060-3064
AGENTS_DEV_PORT=3060
AGENTS_DEV_INSPECTOR_PORT=3061

# `AgentV2Service`: 3065-3069
AGENTS_V2_DEV_PORT=3065

# `ResourceService`: 3070-3079
RESOURCES_DEV_PORT=3070
RESOURCES_DEV_INSPECTOR_PORT=3071

# `dev` process manager: 3500-3509
BAZEL_DEV_SERVER_PORT=3500
BAZEL_REMOTE_CACHE_PORT=3501

# DynamoDB local: 3510-3519 (GUI always runs on `DYNAMO_LOCAL_PORT + 1`)
DYNAMO_LOCAL_PORT=3510

# OpenSearch local: 3520-3529 (GUI always runs on `OPENSEARCH_LOCAL_PORT + 1`)
OPENSEARCH_LOCAL_PORT=3520

# SQS local (ElasticMQ): 3530-3539
SQS_LOCAL_PORT=3530
SQS_LOCAL_STATS_PORT=3531

# Remotion Studio: 3540-3549
REMOTION_STUDIO_PORT=3540
REMOTION_PUBLIC_PORT=3541

load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//admin/typescript:typescript.bzl", "ts_project")

ts_project(
    name = "rpc",
    visibility = ["//visibility:public"],
    deps = [
        "//shared/access",
        "//shared/accounts",
        "//shared/alpha",
        "//shared/bots",
        "//shared/chat",
        "//shared/content",
        "//shared/context",
        "//shared/documents",
        "//shared/dynamo",
        "//shared/error",
        "//shared/feed",
        "//shared/files",
        "//shared/forum",
        "//shared/helpers",
        "//shared/id",
        "//shared/importer/notion",
        "//shared/messaging",
        "//shared/notifications",
        "//shared/prosemirror",
        "//shared/schema",
        "//shared/search",
        "//shared/spaces",
        "//shared/spell_check",
        "//shared/tasks",
        "//shared/tracer",
    ],
)

ALL_RPC_DEFINITION_SRCS = glob(["*_rpc_definitions.ts"])

genrule(
    name = "all_rpc_definitions_file",
    srcs = [],
    outs = ["all_rpc_definitions.js"],
    cmd = "printf \"// @generated by //shared/rpc:all_rpc_definitions_file\n\nimport {{InternalError}} from \\\"../error/error.js\\\";\nimport {{quote}} from \\\"../helpers/string/quote.js\\\";\n\n{}\nexport const allRpcDefinitions = new Map();\n\nfor (const object of [\n{}]) {{\n    for (const [key, value] of Object.entries(object)) {{\n        if (allRpcDefinitions.has(key)) {{\n            throw new InternalError(quote\\`Duplicate RPC definition for \\$${{key}}\\`);\n        }}\n        allRpcDefinitions.set(key, value);\n    }}\n}}\n\" > \"$@\"".format(
        "".join([
            "import * as rpcDefinitions{} from \\\"./{}.js\\\";\n".format(
                index + 1,
                ALL_RPC_DEFINITION_SRCS[index][:ALL_RPC_DEFINITION_SRCS[index].rindex(".")],
            )
            for index in range(
                0,
                len(ALL_RPC_DEFINITION_SRCS),
            )
        ]),
        "".join([
            "    rpcDefinitions{},\n".format(index + 1)
            for index in range(
                0,
                len(ALL_RPC_DEFINITION_SRCS),
            )
        ]),
    ),
)

js_library(
    name = "all_rpc_definitions",
    srcs = [
        "all_rpc_definitions.d.ts",
        ":all_rpc_definitions_file",
    ],
    # We don't want to let any client code import `all_rpc_definitions.js`!
    # Including all RPC definitions will lead to a bloated client bundle.
    visibility = ["//server/rpc:__pkg__"],
    deps = [
        "//shared/error",
        "//shared/helpers",
    ],
)

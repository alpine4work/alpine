load("@aspect_rules_js//js:defs.bzl", "js_library")
load("//admin/typescript:typescript.bzl", "ts_project")

ts_project(
    name = "rpc",
    visibility = ["//visibility:public"],
    deps = [
        ":all_rpc_definitions",
        "//shared/accounts",
        "//shared/alpha",
        "//shared/chat",
        "//shared/context",
        "//shared/documents",
        "//shared/dynamo",
        "//shared/error",
        "//shared/forum",
        "//shared/helpers",
        "//shared/notifications",
        "//shared/schema",
    ],
)

genrule(
    name = "all_rpc_definitions_file",
    srcs = [],
    outs = ["all_rpc_definitions.js"],
    cmd = "printf \"// @generated by //shared/rpc:all_rpc_definitions_file\n\n{}\" > \"$@\"".format("".join([
        "import \\\"./{}.js\\\";\n".format(file[:file.rindex(".")])
        for file in glob(
            [
                "**/*.ts",
                "**/*.tsx",
            ],
            exclude = [
                "**/*.test.ts",
                "**/*.test.tsx",
                "**/*.d.ts",
                "**/*.d.tsx",
                "internal/**/*.ts",
                "internal/**/*.tsx",
            ],
        )
    ])),
)

js_library(
    name = "all_rpc_definitions",
    srcs = [":all_rpc_definitions_file"],
)

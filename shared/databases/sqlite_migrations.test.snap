exports[`sqlite migrations join table migration up to 1 1`] = `
"// table _alpine_join_table _alpine_join_table
CREATE TABLE _alpine_join_table (
    id TEXT PRIMARY KEY,
    table_name TEXT NOT NULL,
    source_table_id TEXT NOT NULL,
    source_field_id TEXT NOT NULL,
    target_table_id TEXT NOT NULL,
    target_field_id TEXT NOT NULL,
    source_row_id_column_name TEXT NOT NULL,
    source_position_column_name TEXT NOT NULL,
    target_row_id_column_name TEXT NOT NULL,
    target_position_column_name TEXT NOT NULL,
    CHECK (id = '<joinTableId>'),
    CHECK (is_id (source_table_id)),
    CHECK (is_id (source_field_id)),
    CHECK (is_id (target_table_id)),
    CHECK (is_id (target_field_id))
) STRICT,
WITHOUT ROWID"
`;

exports[`sqlite migrations main migration up to 1 1`] = `
"// table _alpine_tables _alpine_tables
CREATE TABLE _alpine_tables (
    id TEXT PRIMARY KEY,
    kind TEXT NOT NULL,
    CHECK (is_id (id)),
    CHECK (kind IN ('table', 'join'))
) STRICT,
WITHOUT ROWID

// table _alpine_views _alpine_views
CREATE TABLE _alpine_views (
    id TEXT PRIMARY KEY,
    table_id TEXT NOT NULL REFERENCES _alpine_tables (id) DEFERRABLE INITIALLY DEFERRED,
    CHECK (is_id (id)),
    CHECK (is_id (table_id))
) STRICT,
WITHOUT ROWID"
`;

exports[`sqlite migrations table migration up to 1 1`] = `
"// index _alpine_view_fields_view_id _alpine_view_fields
CREATE INDEX _alpine_view_fields_view_id ON _alpine_view_fields (view_id, position)

// table _alpine_fields _alpine_fields
CREATE TABLE _alpine_fields (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    column_name TEXT NOT NULL,
    config BLOB NOT NULL,
    UNIQUE (column_name),
    CHECK (is_id (id)),
    CHECK (JSON_VALID(config, 8))
) STRICT,
WITHOUT ROWID

// table _alpine_table _alpine_table
CREATE TABLE _alpine_table (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    table_name TEXT NOT NULL,
    name_field_id TEXT NOT NULL REFERENCES _alpine_fields (id) DEFERRABLE INITIALLY DEFERRED,
    CHECK (id = '<tableId>')
) STRICT,
WITHOUT ROWID

// table _alpine_view_fields _alpine_view_fields
CREATE TABLE _alpine_view_fields (
    view_id TEXT NOT NULL REFERENCES _alpine_views (id) DEFERRABLE INITIALLY DEFERRED,
    field_id TEXT NOT NULL REFERENCES _alpine_fields (id) DEFERRABLE INITIALLY DEFERRED,
    position TEXT NOT NULL,
    width INTEGER NOT NULL,
    is_visible INTEGER NOT NULL DEFAULT 1,
    PRIMARY KEY (view_id, field_id),
    CHECK (is_id (view_id)),
    CHECK (is_id (field_id)),
    CHECK (is_order_key (position))
) STRICT,
WITHOUT ROWID

// table _alpine_views _alpine_views
CREATE TABLE _alpine_views (
    id TEXT PRIMARY KEY,
    name TEXT NOT NULL,
    CHECK (is_id (id))
) STRICT,
WITHOUT ROWID"
`;

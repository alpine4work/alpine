exports[`can initially highlight syntax 1`] = `
"<h1><br /></h1>
<p>
  Given a string containing just the characters “
  <code>(</code>
  ”, “
  <code>)</code>
  ”, “
  <code>[</code>
  ”, “
  <code>]</code>
  ”, “
  <code>{</code>
  ”, and “
  <code>}</code>
  ” determine if the input string is valid.
</p>
<p>An input string is valid if:</p>
<div style="--list-item-indent: 0" data-list-indent="0" data-list-number="0">
  <p>Open brackets must be closed by the same type of brackets.</p>
</div>
<div style="--list-item-indent: 0" data-list-indent="0" data-list-number="0">
  <p>Open brackets must be closed in the correct order.</p>
</div>
<div style="--list-item-indent: 0" data-list-indent="0" data-list-number="0">
  <p>Every close bracket has a corresponding open bracket of the same type.</p>
</div>
<div data-scrollbar="false">
  <code>

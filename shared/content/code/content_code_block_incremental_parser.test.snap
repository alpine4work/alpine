exports[`can initially highlight syntax 1`] = `
"<h1 class="content_title"><br /></h1>
<p class="content_paragraph">
  Given a string containing just the characters “
  <code class="content_code">(</code>
  ”, “
  <code class="content_code">)</code>
  ”, “
  <code class="content_code">[</code>
  ”, “
  <code class="content_code">]</code>
  ”, “
  <code class="content_code">{</code>
  ”, and “
  <code class="content_code">}</code>
  ” determine if the input string is valid.
</p>
<p class="content_paragraph">An input string is valid if:</p>
<div
  class="content_listItem content_orderedListItem"
  style="--content_listItemIndentation: 0"
  data-list-indent="0"
  data-list-number="0"
>
  <p class="content_paragraph">
    Open brackets must be closed by the same type of brackets.
  </p>
</div>
<div
  class="content_listItem content_orderedListItem"
  style="--content_listItemIndentation: 0"
  data-list-indent="0"
  data-list-number="0"
>
  <p class="content_paragraph">
    Open brackets must be closed in the correct order.
  </p>
</div>
<div
  class="content_listItem content_orderedListItem"
  style="--content_listItemIndentation: 0"
  data-list-indent="0"
  data-list-number="0"
>
  <p class="content_paragraph">
    Every close bracket has a corresponding open bracket of the same type.
  </p>
</div>
<div class="content_codeBlockWrapper">
  <div class="content_codeBlockWrapper2" data-scrollbar="false">
    <code class="content_codeBlock">
      <div class="content_codeBlockLine">
        <div class="content_codeBlockLineContent">
          <span class="tok-keyword">function</span>
          <span class="tok-variableName tok-definition">isValid</span>
          <span class="tok-punctuation">(</span>
          <span class="tok-variableName tok-definition">string</span>
          <span class="tok-punctuation">:</span>
          <span class="tok-typeName">string</span>
          <span class="tok-punctuation">)</span>
          <span class="tok-punctuation">:</span>
          <span class="tok-typeName">boolean</span>
          <span class="tok-punctuation">{</span>
        </div>
      </div>
      <div class="content_codeBlockLine">
        <div class="content_codeBlockLineContent">
          <span class="tok-keyword">const</span>
          <span class="tok-variableName tok-definition">stack</span>
          <span class="tok-punctuation">:</span>
          <span class="tok-typeName">Array</span>
          &lt;
          <span class="tok-string">"("</span>
          <span class="tok-operator">|</span>
          <span class="tok-string">"["</span>
          <span class="tok-operator">|</span>
          <span class="tok-string">"{"</span>
          &gt;
          <span class="tok-operator">=</span>
          <span class="tok-punctuation">[</span>
          <span class="tok-punctuation">]</span>
          <span class="tok-punctuation">;</span>
        </div>
      </div>
      <div class="content_codeBlockLine">
        <div class="content_codeBlockLineContent"><br /></div>
      </div>
      <div class="content_codeBlockLine">
        <div class="content_codeBlockLineContent">
          <span class="tok-keyword tok-controlKeyword">for</span>
          <span class="tok-punctuation">(</span>
          <span class="tok-keyword">let</span>
          <span class="tok-variableName tok-definition">i</span>
          <span class="tok-operator">=</span>
          <span class="tok-number">0</span>
          <span class="tok-punctuation">;</span>
          <span class="tok-variableName">i</span>
          <span class="tok-operator">&lt;</span>
          <span class="tok-variableName">string</span>
          <span class="tok-operator">.</span>
          <span class="tok-propertyName">length</span>
          <span class="tok-punctuation">;</span>
          <span class="tok-variableName">i</span>
          <span class="tok-operator">++</span>
          <span class="tok-punctuation">)</span>
          <span class="tok-punctuation">{</span>
        </div>
      </div>
      <div class="content_codeBlockLine">
        <div class="content_codeBlockLineContent">
          <span class="tok-keyword">const</span>
          <span class="tok-variableName tok-definition">c</span>
          <span class="tok-operator">=</span>
          <span class="tok-variableName">string</span>
          <span class="tok-punctuation">[</span>
          <span class="tok-variableName">i</span>
          <span class="tok-punctuation">]</span>
          <span class="tok-punctuation">;</span>
        </div>
      </div>
      <div class="content_codeBlockLine">
        <div class="content_codeBlockLineContent"><br /></div>
      </div>
      <div class="content_codeBlockLine">
        <div class="content_codeBlockLineContent">
          <span class="tok-keyword tok-controlKeyword">switch</span>
          <span class="tok-punctuation">(</span>
